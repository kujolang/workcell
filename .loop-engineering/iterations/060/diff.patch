+    touch "$marker.run"
+    echo "daemon startup failure" >&2
+    exit 125
+    ;;
+  inspect)
+    touch "$marker.inspect"
+    echo "No such container" >&2
+    exit 1
+    ;;
+  stop)
+    touch "$marker.stop"
+    echo "No such container" >&2
+    exit 1
+    ;;
+  rm)
+    touch "$marker.rm"
+    echo "No such container" >&2
+    exit 1
+    ;;
