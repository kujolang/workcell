#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
VERIFY="$ROOT/runtime/verify-integrity.sh"
EXPECTED_VERIFY="3237e4ce238689cec5df6efa987a319b2586310c93004f0ab302ca1f3a56253d"
if [ ! -f "$VERIFY" ]; then
  echo "WorkCell adapter integrity verifier is missing" >&2
  exit 70
fi
if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL_VERIFY="$(sha256sum "$VERIFY" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
  ACTUAL_VERIFY="$(shasum -a 256 "$VERIFY" | awk '{print $1}')"
else
  echo "WorkCell adapter integrity check requires sha256sum or shasum" >&2
  exit 70
fi
if [ "$ACTUAL_VERIFY" != "$EXPECTED_VERIFY" ]; then
  echo "WorkCell adapter integrity verifier failed validation" >&2
  exit 70
fi
"$VERIFY" "$ROOT"
exec node "$ROOT/runtime/adapter.mjs" daytona "${1:-}"
