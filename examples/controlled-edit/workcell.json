{
  "version": 1,
  "name": "controlled-repository-edit",
  "runtime": {"backend": "docker", "image": "kujolang/workcell-base:local", "build_context": ""},
  "workspace": {"strategy": "git-worktree", "mount_path": "/workspace"},
  "command": ["sh", "-lc", "printf '\\nEdited inside a disposable Workcell.\\n' >> README.md"],
  "environment": {"allow": [], "set": {}},
  "secrets": [],
  "resources": {"cpus": 1, "memory": "256m", "pids": 64, "timeout_ms": 60000},
  "network": {"mode": "none"},
  "filesystem": {"read_only_root": true, "tmpfs": ["/tmp"]},
  "artifacts": {"export": ["README.md"]},
  "cleanup": {"keep_failed": false},
  "trust_profile": "contained-open",
  "receipt": {"path": ".workcell/runs"}
}
