# Experimental local harness; config file is operator-owned, never producer evidence.
from src.evidence.git_effect import git_effect_apply, git_effect_observe
args := args()
config := parse_json(read_file_beneath(args[0], "config.json", 8192))
if args[1] == "observe" {
    print(to_json(git_effect_observe(config["repo"], config["intent"], config["old_oid"], config["new_oid"])))
} else {
    print(to_json(git_effect_apply(config["repo"], config["intent"], config["old_oid"], config["new_oid"], args[1])))
}
