# Provider-neutral Workcell backend contract value constructors and validators.

from src.util import get_or, has_key_safe, valid_run_id

export func backend_contract_id() {
    return "workcell-backend/v1alpha1"
}

export func valid_support(value) {
    return value == "supported"||value == "unsupported"||value == "conditional"||value == "unknown"
}

export func valid_acceptance(value) {
    return value == "accepted"||value == "rejected"||value == "degraded"||value == "not-requested"
}

export func valid_enforcement_status(value) {
    return value == "workcell-enforced"||value == "provider-claimed"||value == "operator-claimed"||value == "not-enforceable"||value == "unsupported"||value == "unknown"
}

export func valid_observation_status(value) {
    return value == "observed"||value == "not-observed"||value == "contradicted"||value == "not-applicable"
}

export func valid_operation(value) {
    return value == "describe"||value == "resolve"||value == "provision"||value == "prepare"||value == "execute"||value == "cancel"||value == "collect"||value == "export"||value == "destroy"||value == "inventory"||value == "pause"||value == "resume"||value == "snapshot"||value == "metrics"
}

export func backend_identity(adapter, adapter_version, provider, provider_api, substrate) {
    return {
        "adapter": adapter,
        "adapter_version": adapter_version,
        "provider": provider,
        "provider_api": provider_api,
        "substrate": substrate
    }
}

export func validate_backend_identity(value) {
    if type(value) != "dict" {
        return {"ok": false, "error": "backend identity must be an object"}
    }
fields := ["adapter", "adapter_version", "provider", "provider_api", "substrate"]
mut i := 0
while i < len(fields) {
    field := fields[i]
    if type(get_or(value, field, null)) != "string"||trim(value[field]) == "" {
        return {"ok": false, "error": "backend identity " + field + " must be a non-empty string"}
    }
i = i + 1
}
return {"ok": true}
}

export func capability_state(id, support, requested, acceptance, resolved, enforcement, observation, limitations) {
    return {
        "id": id,
        "support": support,
        "requested": requested,
        "acceptance": acceptance,
        "resolved": resolved,
        "enforcement": enforcement,
        "observation": observation,
        "limitations": limitations
    }
}

export func validate_capability_state(value) {
    if type(value) != "dict" {
        return {"ok": false, "error": "capability state must be an object"}
    }
if type(get_or(value, "id", null)) != "string"||trim(value["id"]) == "" {
    return {"ok": false, "error": "capability id must be a non-empty string"}
}
if valid_support(get_or(value, "support", null)) == false {
    return {"ok": false, "error": "invalid capability support for " + value["id"]}
}
if type(get_or(value, "requested", null)) != "bool" {
    return {"ok": false, "error": "capability requested must be boolean for " + value["id"]}
}
if valid_acceptance(get_or(value, "acceptance", null)) == false {
    return {"ok": false, "error": "invalid capability acceptance for " + value["id"]}
}
enforcement := get_or(value, "enforcement", null)
if type(enforcement) != "dict"||valid_enforcement_status(get_or(enforcement, "status", null)) == false {
    return {"ok": false, "error": "invalid capability enforcement for " + value["id"]}
}
observation := get_or(value, "observation", null)
if type(observation) != "dict"||valid_observation_status(get_or(observation, "status", null)) == false {
    return {"ok": false, "error": "invalid capability observation for " + value["id"]}
}
if type(get_or(value, "limitations", null)) != "array" {
    return {"ok": false, "error": "capability limitations must be an array for " + value["id"]}
}
return {"ok": true}
}

export func backend_handle(backend, adapter_version, provider, profile_fingerprint, resource_ids, run_identifier, nonce, provider_state) {
    return {
        "backend": backend,
        "adapter_version": adapter_version,
        "provider": provider,
        "profile_fingerprint": profile_fingerprint,
        "resource_ids": resource_ids,
        "ownership": {"run_id": run_identifier, "nonce": nonce},
        "provider_state": provider_state
    }
}

export func validate_backend_handle(value, expected_run_id) {
    if type(value) != "dict" {
        return {"ok": false, "error": "backend handle must be an object"}
    }
fields := ["backend", "adapter_version", "provider", "profile_fingerprint"]
mut i := 0
while i < len(fields) {
    field := fields[i]
    if type(get_or(value, field, null)) != "string"||trim(value[field]) == "" {
        return {"ok": false, "error": "backend handle " + field + " must be a non-empty string"}
    }
i = i + 1
}
if type(get_or(value, "resource_ids", null)) != "array"||len(value["resource_ids"]) == 0 {
    return {"ok": false, "error": "backend handle resource_ids must be a non-empty array"}
}
ownership := get_or(value, "ownership", null)
if type(ownership) != "dict"||valid_run_id(get_or(ownership, "run_id", "")) == false||type(get_or(ownership, "nonce", null)) != "string"||trim(ownership["nonce"]) == "" {
    return {"ok": false, "error": "backend handle ownership is invalid"}
}
if type(expected_run_id) == "string"&&expected_run_id != ""&&ownership["run_id"] != expected_run_id {
    return {"ok": false, "error": "backend handle ownership run id mismatch"}
}
if type(get_or(value, "provider_state", null)) != "dict" {
    return {"ok": false, "error": "backend handle provider_state must be an object"}
}
return {"ok": true}
}

export func terminal_result(status, exit_code, signal, reason, timed_out, cancelled, certainty) {
    return {
        "status": status,
        "exit_code": exit_code,
        "signal": signal,
        "reason": reason,
        "timed_out": timed_out,
        "cancelled": cancelled,
        "certainty": certainty
    }
}

export func validate_terminal_result(value) {
    if type(value) != "dict" {
        return {"ok": false, "error": "terminal result must be an object"}
    }
status := get_or(value, "status", null)
if status != "exited"&&status != "signaled"&&status != "timed-out"&&status != "cancelled"&&status != "unknown" {
    return {"ok": false, "error": "terminal status is invalid"}
}
if type(get_or(value, "timed_out", null)) != "bool"||type(get_or(value, "cancelled", null)) != "bool" {
    return {"ok": false, "error": "terminal timeout and cancellation fields must be boolean"}
}
certainty := get_or(value, "certainty", null)
if certainty != "terminal"&&certainty != "unknown" {
    return {"ok": false, "error": "terminal certainty must be terminal or unknown"}
}
if status == "unknown"&&certainty != "unknown" {
    return {"ok": false, "error": "unknown terminal status requires unknown certainty"}
}
return {"ok": true}
}

export func backend_error(code, message, retryable, provider_code) {
    return {"code": code, "message": message, "retryable": retryable, "provider_code": provider_code}
}

export func protocol_result(request, ok, status, retryable, data, error) {
    mut result := {
        "contract": backend_contract_id(),
        "request_id": get_or(request, "request_id", ""),
        "run_id": get_or(request, "run_id", ""),
        "operation": get_or(request, "operation", ""),
        "type": "result",
        "ok": ok,
        "status": status,
        "retryable": retryable,
        "data": data
    }
if ok == false {
    result["error"] := error
}
return result
}

export func validate_protocol_request(value) {
    if type(value) != "dict" {
        return {"ok": false, "error": "backend request must be an object"}
    }
if get_or(value, "contract", "") != backend_contract_id() {
    return {"ok": false, "error": "backend contract is unsupported"}
}
if type(get_or(value, "request_id", null)) != "string"||trim(value["request_id"]) == "" {
    return {"ok": false, "error": "backend request_id must be a non-empty string"}
}
if valid_run_id(get_or(value, "run_id", "")) == false {
    return {"ok": false, "error": "backend run_id is invalid"}
}
if valid_operation(get_or(value, "operation", null)) == false {
    return {"ok": false, "error": "backend operation is invalid"}
}
if type(get_or(value, "deadline_ms", null)) != "int"||value["deadline_ms"] <= 0 {
    return {"ok": false, "error": "backend deadline_ms must be positive"}
}
if type(get_or(value, "profile", null)) != "dict"||type(get_or(value, "payload", null)) != "dict" {
    return {"ok": false, "error": "backend profile and payload must be objects"}
}
return {"ok": true}
}
