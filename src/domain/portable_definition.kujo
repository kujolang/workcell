# Provider-neutral Workcell v2 definition and explicit host-profile loading.

from src.domain.definition import load_definition
from src.util import get_or, load_json, normalized_relative

export func portable_definition_schema_version() {
    return "workcell-definition/v2alpha1"
}

export func host_profiles_schema_version() {
    return "workcell-host-profiles/v1alpha1"
}

func keys_allowed(value, allowed, label) {
    if type(value) != "dict" {return {"ok": false, "error": label + " must be an object"}}
    names := keys(value)
    mut i := 0
    while i < len(names) {
        mut found := false
        mut j := 0
        while j < len(allowed) {
            if names[i] == allowed[j] {found = true}
            j = j + 1
        }
        if found == false {return {"ok": false, "error": "unknown field " + label + "." + names[i]}}
        i = i + 1
    }
    return {"ok": true}
}

func nonempty(value) {
    return type(value) == "string"&&trim(value) != ""
}

func string_array(value, label) {
    if type(value) != "array" {return {"ok": false, "error": label + " must be an array"}}
    mut i := 0
    while i < len(value) {
        if nonempty(value[i]) == false {return {"ok": false, "error": label + " must contain non-empty strings"}}
        i = i + 1
    }
    return {"ok": true}
}

func validate_relative_list(values, label) {
    checked := string_array(values, label)
    if checked["ok"] == false {return checked}
    mut seen := {}
    mut i := 0
    while i < len(values) {
        path := normalized_relative(values[i])
        if path["ok"] == false||path["path"] != values[i]||has_key(seen, values[i]) == 1 {
            return {"ok": false, "error": label + " contains an unsafe or duplicate path"}
        }
        seen[values[i]] := true
        i = i + 1
    }
    return {"ok": true}
}

export func validate_portable_definition(raw) {
    top := keys_allowed(raw, ["schema", "name", "workload", "workspace", "environment", "secrets", "requirements", "artifacts", "verification", "cleanup", "receipt"], "definition")
    if top["ok"] == false {return top}
    if get_or(raw, "schema", "") != portable_definition_schema_version() {return {"ok": false, "error": "portable definition schema is unsupported"}}
    if nonempty(get_or(raw, "name", null)) == false||len(raw["name"]) > 128 {return {"ok": false, "error": "name must be a bounded non-empty string"}}

    workload := get_or(raw, "workload", null)
    checked := keys_allowed(workload, ["kind", "image", "command", "working_directory"], "workload")
    if checked["ok"] == false {return checked}
    if get_or(workload, "kind", "") != "linux-process" {return {"ok": false, "error": "workload.kind must be linux-process"}}
    image := get_or(workload, "image", null)
    checked = keys_allowed(image, ["reference", "digest", "signature_key"], "workload.image")
    if checked["ok"] == false {return checked}
    if nonempty(get_or(image, "reference", null)) == false {return {"ok": false, "error": "workload.image.reference must be a non-empty string"}}
    digest := get_or(image, "digest", "")
    if digest != ""&&starts_with(digest, "sha256:") == false {return {"ok": false, "error": "workload.image.digest must be a sha256 digest"}}
    checked = string_array(get_or(workload, "command", null), "workload.command")
    if checked["ok"] == false||len(workload["command"]) == 0 {return {"ok": false, "error": "workload.command must contain at least one argument"}}
    if get_or(workload, "working_directory", "") != "/workspace" {return {"ok": false, "error": "workload.working_directory must be /workspace in v2alpha1"}}

    workspace := get_or(raw, "workspace", null)
    checked = keys_allowed(workspace, ["source", "materialization", "mount_path", "scan"], "workspace")
    if checked["ok"] == false {return checked}
    if get_or(workspace, "source", "") != "clean-git-commit"||get_or(workspace, "materialization", "") != "portable-clone"||get_or(workspace, "mount_path", "") != "/workspace" {
        return {"ok": false, "error": "v2alpha1 workspace requires clean-git-commit, portable-clone, and /workspace"}
    }

    environment := get_or(raw, "environment", null)
    checked = keys_allowed(environment, ["allow", "set"], "environment")
    if checked["ok"] == false {return checked}
    checked = string_array(get_or(environment, "allow", null), "environment.allow")
    if checked["ok"] == false||type(get_or(environment, "set", null)) != "dict" {return {"ok": false, "error": "environment allow/set are invalid"}}
    checked = string_array(get_or(raw, "secrets", null), "secrets")
    if checked["ok"] == false {return checked}

    requirements := get_or(raw, "requirements", null)
    checked = keys_allowed(requirements, ["compute", "execution", "network", "filesystem"], "requirements")
    if checked["ok"] == false {return checked}
    compute := get_or(requirements, "compute", null)
    execution := get_or(requirements, "execution", null)
    network := get_or(requirements, "network", null)
    filesystem := get_or(requirements, "filesystem", null)
    for pair in [[compute, ["cpus", "memory", "pids"], "requirements.compute"], [execution, ["timeout_ms", "max_output_bytes"], "requirements.execution"], [network, ["mode", "allow"], "requirements.network"], [filesystem, ["read_only_root", "writable", "tmpfs"], "requirements.filesystem"]] {
        checked = keys_allowed(pair[0], pair[1], pair[2])
        if checked["ok"] == false {return checked}
    }
    if type(get_or(compute, "cpus", null)) != "int"||compute["cpus"] <= 0||nonempty(get_or(compute, "memory", null)) == false||type(get_or(compute, "pids", null)) != "int"||compute["pids"] <= 0 {return {"ok": false, "error": "compute requirements are invalid"}}
    if type(get_or(execution, "timeout_ms", null)) != "int"||execution["timeout_ms"] <= 0||type(get_or(execution, "max_output_bytes", null)) != "int"||execution["max_output_bytes"] <= 0 {return {"ok": false, "error": "execution requirements are invalid"}}
    if get_or(network, "mode", "") != "none"&&get_or(network, "mode", "") != "default"&&get_or(network, "mode", "") != "allowlist" {return {"ok": false, "error": "network mode must be none, default, or allowlist"}}
    if get_or(network, "mode", "") == "allowlist"&&len(get_or(network, "allow", [])) == 0 {return {"ok": false, "error": "network allowlist mode requires entries"}}
    if type(get_or(filesystem, "read_only_root", null)) != "bool" {return {"ok": false, "error": "filesystem.read_only_root must be boolean"}}
    checked = string_array(get_or(filesystem, "writable", []), "requirements.filesystem.writable")
    if checked["ok"] == false {return checked}
    checked = string_array(get_or(filesystem, "tmpfs", []), "requirements.filesystem.tmpfs")
    if checked["ok"] == false {return checked}

    artifacts := get_or(raw, "artifacts", null)
    checked = keys_allowed(artifacts, ["export", "limits", "max_bytes", "max_files", "max_depth", "allowed_extensions", "secret_action"], "artifacts")
    if checked["ok"] == false {return checked}
    checked = validate_relative_list(get_or(artifacts, "export", null), "artifacts.export")
    if checked["ok"] == false {return checked}
    if type(get_or(raw, "verification", null)) != "dict"||type(get_or(raw, "cleanup", null)) != "dict"||type(get_or(raw, "receipt", null)) != "dict" {return {"ok": false, "error": "verification, cleanup, and receipt must be objects"}}
    verification := raw["verification"]
    checked = keys_allowed(verification, ["version", "commands"], "verification")
    if checked["ok"] == false {return checked}
    commands := get_or(verification, "commands", null)
    if get_or(verification, "version", null) != 1||type(commands) != "array"||len(commands) > 32 {return {"ok": false, "error": "verification requires version 1 and at most 32 commands"}}
    mut check_i := 0
    while check_i < len(commands) {
        check := commands[check_i]
        checked = keys_allowed(check, ["name", "command"], "verification.commands")
        if checked["ok"] == false||nonempty(get_or(check, "name", null)) == false {return {"ok": false, "error": "verification command name is invalid"}}
        checked = string_array(get_or(check, "command", null), "verification command")
        if checked["ok"] == false||len(check["command"]) == 0 {return {"ok": false, "error": "verification command argv is invalid"}}
        check_i = check_i + 1
    }
    if type(get_or(raw["cleanup"], "keep_failed", null)) != "bool" {return {"ok": false, "error": "cleanup.keep_failed must be boolean"}}
    if nonempty(get_or(raw["receipt"], "path", null)) == false {return {"ok": false, "error": "receipt.path must be a non-empty string"}}
    return {"ok": true}
}

export func resolve_portable_definition(raw) {
    checked := validate_portable_definition(raw)
    if checked["ok"] == false {return checked}
    definition := raw
    scan := get_or(definition["workspace"], "scan", {})
    scan["max_files"] := get_or(scan, "max_files", 100000)
    scan["max_bytes"] := get_or(scan, "max_bytes", 1000000000)
    scan["max_depth"] := get_or(scan, "max_depth", 128)
    workspace := definition["workspace"]
    workspace["scan"] := scan
    definition["workspace"] := workspace
    artifacts := definition["artifacts"]
    artifacts["max_bytes"] := get_or(artifacts, "max_bytes", 0)
    artifacts["max_files"] := get_or(artifacts, "max_files", 0)
    artifacts["max_depth"] := get_or(artifacts, "max_depth", 32)
    artifacts["allowed_extensions"] := get_or(artifacts, "allowed_extensions", [])
    artifacts["secret_action"] := get_or(artifacts, "secret_action", "allow")
    artifacts["limits"] := get_or(artifacts, "limits", {})
    definition["artifacts"] := artifacts
    return {"ok": true, "definition": definition, "version": 2}
}

export func load_workcell_definition(path) {
    loaded := load_json(path)
    if loaded["ok"] == false {return loaded}
    if type(loaded["value"]) == "dict"&&get_or(loaded["value"], "schema", "") == portable_definition_schema_version() {
        return resolve_portable_definition(loaded["value"])
    }
    legacy := load_definition(path)
    if legacy["ok"] {legacy["version"] := 1}
    return legacy
}

export func load_host_profile(path, profile_id, backend_override) {
    if nonempty(path) == false||nonempty(profile_id) == false {return {"ok": false, "error": "portable execution requires explicit --profiles and --profile values"}}
    loaded := load_json(path)
    if loaded["ok"] == false||type(loaded["value"]) != "dict" {return {"ok": false, "error": "host profiles file is unreadable or invalid"}}
    value := loaded["value"]
    checked := keys_allowed(value, ["schema", "profiles"], "host-profiles")
    if checked["ok"] == false {return checked}
    if get_or(value, "schema", "") != host_profiles_schema_version()||type(get_or(value, "profiles", null)) != "dict"||has_key(value["profiles"], profile_id) == 0 {return {"ok": false, "error": "requested host profile is missing or schema is unsupported"}}
    profile := value["profiles"][profile_id]
    checked = keys_allowed(profile, ["backend", "credential_ref", "region", "provider_project", "endpoint", "adapter_options", "policy"], "profile")
    if checked["ok"] == false {return checked}
    if nonempty(get_or(profile, "backend", null)) == false {return {"ok": false, "error": "host profile backend must be a non-empty string"}}
    if nonempty(backend_override)&&backend_override != profile["backend"] {return {"ok": false, "error": "--backend conflicts with selected host profile"}}
    credential_ref := get_or(profile, "credential_ref", "")
    if credential_ref != "" {
        if contains(credential_ref, "=") == 1||contains(credential_ref, "\n") == 1||contains(credential_ref, "\r") == 1 {return {"ok": false, "error": "credential_ref must name a credential, never contain credential material"}}
        if starts_with(credential_ref, "env:") {
            name := substring(credential_ref, 4, len(credential_ref))
            if nonempty(name) == false||len(name) > 128 {
                return {"ok": false, "error": "environment credential reference is invalid"}
            }
            mut env_i := 0
            while env_i < len(name) {
                if contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", substring(name, env_i, env_i + 1)) == 0 {return {"ok": false, "error": "environment credential reference is invalid"}}
                env_i = env_i + 1
            }
        } else if starts_with(credential_ref, "kujo-agent:") == false&&starts_with(credential_ref, "os-store:") == false {
            return {"ok": false, "error": "credential_ref must use env:, kujo-agent:, or os-store:"}
        }
    }
    profile["adapter_options"] := get_or(profile, "adapter_options", {})
    profile["policy"] := get_or(profile, "policy", {})
    fingerprint := ""
    try {fingerprint = sha256(to_json(profile))} except err {return {"ok": false, "error": "host profile could not be fingerprinted"}}
    return {"ok": true, "id": profile_id, "profile": profile, "backend": profile["backend"], "fingerprint": fingerprint}
}
