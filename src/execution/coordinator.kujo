# Explicit Workcell lifecycle coordinator.

from src.artifacts.exporter import export_declared, write_execution_logs
from src.domain.definition import load_definition
from src.receipts.receipt import add_error, add_state, finish_receipt, new_receipt, write_receipt
from src.runtime.docker import ensure_image, run_container, remove_container
from src.util import ensure_dir, get_or, iso_now, run_id, save_json, write_text
from src.workspace.workspace import changed_files, cleanup_workspace, create_workspace, inspect_repository, make_patch
from src.policy.policy import build_policy

func option(flags, name, fallback) {
    if type(flags) == "dict" && has_key(flags, name) == 1 {
        return flags[name]
    }
    return fallback
}

func is_true(value) {
    return value == true || value == "true" || value == "1" || value == "yes"
}

func output_root_for(repo_root, definition, requested) {
    if type(requested) == "string" && trim(requested) != "" {
        if starts_with(requested, "/") {
            return requested
        }
        return repo_root + "/" + requested
    }
    return repo_root + "/" + definition["receipt"]["path"]
}

func write_failure_note(output_dir, stage, message) {
    ensure_dir(output_dir)
    write_text(output_dir + "/failure.txt", "Workcell failure\nStage: " + stage + "\nCause: " + message + "\nRecorded: " + iso_now() + "\n")
}

func final_result(run_identifier, receipt_path, output_dir, receipt, ok, stage, error, exit_code, timed_out, cleanup_status) {
    return {
        "ok": ok,
        "run_id": run_identifier,
        "receipt_path": receipt_path,
        "output_dir": output_dir,
        "patch_path": receipt["patch_path"],
        "stage": stage,
        "error": error,
        "exit_code": exit_code,
        "timed_out": timed_out,
        "cleanup_status": cleanup_status,
        "receipt": receipt
    }
}

export func run_workcell(definition_path, repo_path, requested_output, flags) {
    run_identifier := run_id()
    loaded := load_definition(definition_path)
    if loaded["ok"] == false {
        return {"ok": false, "run_id": run_identifier, "stage": "validated", "error": loaded["error"], "exit_code": 2}
    }
    definition := loaded["definition"]
    source_info := inspect_repository(repo_path)
    if source_info["ok"] == false {
        return {"ok": false, "run_id": run_identifier, "stage": "preparing", "error": source_info["error"], "exit_code": 3}
    }
    output_root := output_root_for(source_info["root"], definition, requested_output)
    output_dir := output_root + "/" + run_identifier
    ensure_dir(output_dir)
    workspace := create_workspace(source_info["root"], definition["workspace"]["strategy"], run_identifier)
    if workspace["ok"] == false {
        write_failure_note(output_dir, get_or(workspace, "stage", "preparing"), workspace["error"])
        return {"ok": false, "run_id": run_identifier, "stage": get_or(workspace, "stage", "preparing"), "error": workspace["error"], "output_dir": output_dir, "exit_code": 3}
    }
    policy := build_policy(definition, run_identifier, workspace["workspace_path"])
    receipt := new_receipt(definition, definition_path, run_identifier, workspace, workspace, policy, output_dir)
    receipt = add_state(receipt, "validated")
    receipt = add_state(receipt, "preparing")
    receipt = add_state(receipt, "prepared")
    receipt_path := output_dir + "/receipt.json"
    save_json(receipt_path, receipt)

    preserve_failed := is_true(option(flags, "keep_failed", definition["cleanup"]["keep_failed"]))
    if is_true(option(flags, "dry_run", false)) {
        receipt = add_state(receipt, "completed")
        receipt = finish_receipt(receipt, "dry-run", 0, false, "", [], null, [], "not-run")
        write_receipt(receipt, receipt_path)
        cleanup := cleanup_workspace(workspace, false)
        dry_cleanup_status := "failed"
        if get_or(cleanup, "ok", false) {
            dry_cleanup_status = "complete"
        }
        return final_result(run_identifier, receipt_path, output_dir, receipt, true, "completed", "", 0, false, dry_cleanup_status)
    }

    image := ensure_image(definition, workspace["source_root"], run_identifier, is_true(option(flags, "no_pull", false)), is_true(option(flags, "rebuild", false)))
    if image["ok"] == false {
        receipt = add_error(receipt, "preparing", image["error"])
        receipt = add_state(receipt, "failed")
        logs := write_execution_logs(output_dir, get_or(image, "stdout", ""), get_or(image, "stderr", ""), definition["secrets"])
        cleanup := cleanup_workspace(workspace, preserve_failed)
        cleanup_status := "failed"
        if cleanup["ok"] {
            if preserve_failed {
                cleanup_status = "preserved"
            } else {
                cleanup_status = "complete"
            }
        }
        receipt = finish_receipt(receipt, "failed", 4, false, "", [], null, [], cleanup_status)
        write_receipt(receipt, receipt_path)
        return final_result(run_identifier, receipt_path, output_dir, receipt, false, "preparing", image["error"], 4, false, cleanup_status)
    }
    receipt["container_image_digest"] := get_or(image, "digest", "")
    receipt = add_state(receipt, "starting")
    container := run_container(definition, policy)
    if container["ok"] == false {
        receipt = add_error(receipt, "starting", container["error"])
        receipt = add_state(receipt, "failed")
        logs := write_execution_logs(output_dir, "", container["error"], definition["secrets"])
        container_cleanup := remove_container(policy["container_name"])
        if container_cleanup["ok"] == false {
            receipt = add_error(receipt, "cleaning", container_cleanup["message"])
        }
        cleanup := cleanup_workspace(workspace, preserve_failed)
        cleanup_status := "failed"
        if cleanup["ok"] {
            if preserve_failed {
                cleanup_status = "preserved"
            } else {
                cleanup_status = "complete"
            }
        }
        receipt = finish_receipt(receipt, "failed", 5, false, receipt["container_image_digest"], [], null, [], cleanup_status)
        write_receipt(receipt, receipt_path)
        return final_result(run_identifier, receipt_path, output_dir, receipt, false, "starting", container["error"], 5, false, cleanup_status)
    }
    receipt = add_state(receipt, "running")
    logs := write_execution_logs(output_dir, container["stdout"], container["stderr"], definition["secrets"])
    receipt["logs_path"] := output_dir
    receipt = add_state(receipt, "collecting")
    files := changed_files(workspace)
    changed := []
    if files["ok"] {
        changed = files["files"]
    } else {
        receipt = add_error(receipt, "collecting", files["error"])
    }
    patch_path := output_dir + "/changes.patch"
    patch := make_patch(workspace, patch_path)
    if patch["ok"] == false {
        receipt = add_error(receipt, "collecting", patch["error"])
        patch_path = null
    }
    receipt = add_state(receipt, "verifying")
    execution_success := container["success"] == true && container["timed_out"] == false
    if container["timed_out"] {
        receipt = add_error(receipt, "running", "container execution exceeded the configured timeout")
    }
    verification := receipt["verification"]
    verification["verification_succeeded"] := execution_success && patch["ok"]
    receipt["verification"] := verification
    artifacts := export_declared(workspace["workspace_path"], output_dir + "/artifacts", definition["artifacts"]["export"])
    artifact_list := []
    if artifacts["ok"] {
        artifact_list = artifacts["artifacts"]
    } else {
        receipt = add_error(receipt, "exporting", artifacts["error"])
    }
    receipt = add_state(receipt, "exporting")
    if artifacts["ok"] == false {
        receipt = add_state(receipt, "failed")
    } else if execution_success {
        receipt = add_state(receipt, "completed")
    } else {
        receipt = add_state(receipt, "failed")
    }
    container_cleanup := remove_container(container["container_name"])
    if container_cleanup["ok"] == false {
        receipt = add_error(receipt, "cleaning", container_cleanup["message"])
    }
    cleanup := cleanup_workspace(workspace, preserve_failed && execution_success == false)
    cleanup_status := "failed"
    if cleanup["ok"] {
        if get_or(cleanup, "preserved", false) {
            cleanup_status = "preserved"
        } else {
            cleanup_status = "complete"
        }
    } else {
        receipt = add_error(receipt, "cleaning", cleanup["error"])
    }
    if container_cleanup["ok"] == false {
        cleanup_status = "failed"
    }
    exit_code := container["exit_code"]
    final_status := "completed"
    final_ok := execution_success && artifacts["ok"] && cleanup["ok"] && container_cleanup["ok"]
    if container["timed_out"] {
        exit_code = 6
        final_status = "timeout"
        final_ok = false
    } else if container["success"] == false {
        final_status = "workload-failed"
        final_ok = false
    } else if artifacts["ok"] == false {
        exit_code = 7
        final_status = "artifact-failed"
        final_ok = false
    } else if cleanup["ok"] == false || container_cleanup["ok"] == false {
        exit_code = 8
        final_status = "cleanup-failed"
        final_ok = false
    }
    receipt = finish_receipt(receipt, final_status, exit_code, container["timed_out"], receipt["container_image_digest"], changed, patch_path, artifact_list, cleanup_status)
    write_receipt(receipt, receipt_path)
    return final_result(run_identifier, receipt_path, output_dir, receipt, final_ok, final_status, "", exit_code, container["timed_out"], cleanup_status)
}
