# Structured Workcell execution receipts.

from src.util import redact_with_env, save_json
from src.domain.definition import validate_definition

func redacted_command(command, secret_names) {
    mut output := []
    mut i := 0
    while i < len(command) {
        output = push(output, redact_with_env(to_string(command[i]), secret_names))
        i = i + 1
    }
return output
}

export func new_receipt(definition, definition_path, run_identifier, source, workspace, policy, output_dir) {
    definition_check := validate_definition(definition)
    if definition_check["ok"] == false {
        return definition_check
    }
return {
    "schema_version": "workcell-receipt/v1",
    "run_id": run_identifier,
    "workcell_name": definition["name"],
    "workcell_version": definition["version"],
    "workcell_definition_path": definition_path,
    "workcell_definition_hash": sha256_file(definition_path),
    "source_repository": source["source_root"],
    "source_commit": source["source_commit"],
    "workspace_strategy": workspace["strategy"],
    "workspace_path": workspace["workspace_path"],
    "runtime_backend": policy["runtime_backend"],
    "container_image": definition["runtime"]["image"],
    "container_image_digest": "",
    "container_image_id": "",
    "container_image_digest_source": "",
    "container_image_platform": "",
    "container_image_labels": {},
    "image_provenance_policy": {
        "require_digest": definition["runtime"]["require_digest"],
        "require_signature": definition["runtime"]["require_signature"],
        "registry_allowlist": definition["runtime"]["registry_allowlist"]
    },
"container_name": policy["container_name"],
"command": redacted_command(definition["command"], definition["secrets"]),
"start_time": now_utc(),
"end_time": null,
"elapsed": null,
"elapsed_ms": null,
"exit_code": null,
"timeout": false,
"cancelled": false,
"stdout_truncated": false,
"stderr_truncated": false,
"network_mode": policy["network_mode"],
"network_policy": policy["network_policy"],
"resource_limits": policy["resource_limits"],
"secret_names": policy["secret_names"],
"mounts": policy["mounts"],
"effective_security_policy": policy["effective_security_policy"],
"exported_artifacts": [],
"artifact_bytes": 0,
"artifact_files": 0,
"changed_files": [],
"change_report_path": null,
"patch_path": null,
"patch_bytes": 0,
"manifest_path": "manifest.json",
"manifest_schema_version": "workcell-manifest/v1",
"logs_path": output_dir,
"cleanup_status": "pending",
"final_status": "created",
"verification": {
    "execution_succeeded": false,
    "verification_succeeded": false,
    "checks": [],
    "artifacts_exported": false,
    "cleanup_succeeded": false
},
"integrations": [],
"integration_status": "disabled",
"errors": [],
"warnings": policy["warnings"],
"lifecycle": ["created"]
}
}

export func add_state(receipt, state) {
    receipt["lifecycle"] := push(receipt["lifecycle"], state)
    receipt["final_status"] := state
    return receipt
}

export func add_error(receipt, stage, message) {
    errors := receipt["errors"]
    safe_message := redact_with_env(to_string(message), receipt["secret_names"])
    errors = push(errors, {"stage": stage, "message": safe_message})
    receipt["errors"] := errors
    return receipt
}

export func finish_receipt(receipt, final_status, exit_code, timed_out, image_digest, changed, patch_path, artifacts, cleanup_status, elapsed_ms, execution_succeeded, artifacts_succeeded) {
    receipt["end_time"] := now_utc()
    receipt["exit_code"] := exit_code
    receipt["timeout"] := timed_out
    receipt["elapsed"] := elapsed_ms
    receipt["elapsed_ms"] := elapsed_ms
    receipt["container_image_digest"] := image_digest
    receipt["changed_files"] := changed
    receipt["patch_path"] := patch_path
    receipt["exported_artifacts"] := artifacts
    receipt["cleanup_status"] := cleanup_status
    receipt["final_status"] := final_status
    verification := receipt["verification"]
    verification["execution_succeeded"] := final_status != "dry-run"&&execution_succeeded&&timed_out == false
    verification["artifacts_exported"] := final_status != "dry-run"&&artifacts_succeeded == true
    verification["cleanup_succeeded"] := cleanup_status == "complete"||cleanup_status == "preserved"
    receipt["verification"] := verification
    return receipt
}

export func write_receipt(receipt, output_path) {
    try {
        persisted := save_json(output_path, receipt)
        if persisted != true {
            return {"ok": false, "path": output_path, "error": "could not write receipt: atomic write returned false"}
        }
    return {"ok": true, "path": output_path}
} except err {
return {"ok": false, "path": output_path, "error": "could not write receipt: " + to_string(err)}
}
}
