# Docker runtime adapter. All host commands use structured argv.

from src.util import get_or, lines_of, path_has_symlink, process_error, process_ok, proc_exitcode, proc_stderr, proc_stdout, proc_stderr_truncated, proc_stdout_truncated, proc_success, proc_timed_out, run_argv, run_argv_options
from src.policy.policy import spawn_options

func docker_result(argv, timeout_ms) {
    return run_argv(argv, timeout_ms)
}

export func doctor_docker() {
    result := docker_result(["docker", "version", "--format", "{{.Server.Version}}"], 10000)
    if proc_timed_out(result) {
        return {"name": "Docker daemon", "status": "blocked", "message": "Docker daemon check timed out", "remediation": "Start Docker Desktop or the Docker daemon"}
    }
    if proc_success(result) == false {
        return {"name": "Docker daemon", "status": "blocked", "message": "Docker daemon is not reachable: " + trim(proc_stderr(result)), "remediation": "Start Docker Desktop or the Docker daemon"}
    }
    return {"name": "Docker daemon", "status": "passed", "message": "Docker daemon reachable (server " + trim(proc_stdout(result)) + ")", "remediation": ""}
}

export func image_exists(image) {
    result := docker_result(["docker", "image", "inspect", image], 15000)
    return process_ok(result)
}

export func image_digest(image) {
    result := docker_result(["docker", "image", "inspect", "--format", "{{index .RepoDigests 0}}", image], 15000)
    if process_ok(result) == false {
        return ""
    }
    return trim(proc_stdout(result))
}

export func pull_image(image) {
    result := docker_result(["docker", "pull", image], 600000)
    if process_ok(result) == false {
        return {"ok": false, "error": process_error(result, "docker pull " + image), "stdout": proc_stdout(result), "stderr": proc_stderr(result)}
    }
    return {"ok": true, "stdout": proc_stdout(result), "stderr": proc_stderr(result)}
}

export func build_image(image, context_path, run_identifier) {
    mut args := ["docker", "build", "--tag", image, "--label", "dev.kujo.workcell=true", "--label", "dev.kujo.workcell.run_id=" + run_identifier, context_path]
    buildx := docker_result(["docker", "buildx", "version"], 10000)
    if process_ok(buildx) {
        args = ["docker", "buildx", "build", "--load", "--tag", image, "--label", "dev.kujo.workcell=true", "--label", "dev.kujo.workcell.run_id=" + run_identifier, context_path]
    }
    result := docker_result(args, 900000)
    if process_ok(result) == false {
        return {"ok": false, "error": process_error(result, "docker build"), "stdout": proc_stdout(result), "stderr": proc_stderr(result)}
    }
    return {"ok": true, "stdout": proc_stdout(result), "stderr": proc_stderr(result)}
}

func digest_matches(actual, expected) {
    return actual == expected || ends_with(actual, "@" + expected)
}

func verify_image_digest(definition, image, digest) {
    expected := get_or(definition["runtime"], "image_digest", "")
    if expected == "" {
        return {"ok": true}
    }
    if digest_matches(digest, expected) == false {
        return {"ok": false, "error": "runtime.image_digest mismatch for " + image + ": expected " + expected + ", observed " + digest}
    }
    return {"ok": true}
}

export func ensure_image(definition, source_root, run_identifier, no_pull, rebuild) {
    image := definition["runtime"]["image"]
    context := definition["runtime"]["build_context"]
    if context != "" {
        context_path := source_root + "/" + context
        if path_is_dir(context_path) == false {
            return {"ok": false, "error": "runtime.build_context does not exist: " + context_path}
        }
        if path_has_symlink(context_path) {
            return {"ok": false, "error": "runtime.build_context contains a symlink and is not safe: " + context_path}
        }
        if rebuild == false && image_exists(image) {
            digest := image_digest(image)
            verified := verify_image_digest(definition, image, digest)
            if verified["ok"] == false { return verified }
            return {"ok": true, "action": "reused", "digest": digest}
        }
        built := build_image(image, context_path, run_identifier)
        if built["ok"] == false {
            return built
        }
        digest := image_digest(image)
        verified := verify_image_digest(definition, image, digest)
        if verified["ok"] == false { return verified }
        return {"ok": true, "action": "built", "digest": digest, "stdout": built["stdout"]}
    }
    if image_exists(image) {
        digest := image_digest(image)
        verified := verify_image_digest(definition, image, digest)
        if verified["ok"] == false { return verified }
        return {"ok": true, "action": "existing", "digest": digest}
    }
    if no_pull {
        return {"ok": false, "error": "image is not available locally and --no-pull was requested: " + image}
    }
    pulled := pull_image(image)
    if pulled["ok"] == false {
        return pulled
    }
    digest := image_digest(image)
    verified := verify_image_digest(definition, image, digest)
    if verified["ok"] == false { return verified }
    return {"ok": true, "action": "pulled", "digest": digest, "stdout": pulled["stdout"]}
}

export func run_container(definition, policy) {
    options := spawn_options(definition)
    if options["ok"] == false {
        return {"ok": false, "stage": "starting", "error": options["error"]}
    }
    result := run_argv_options(policy["docker_args"], options["options"])
    if proc_success(result) == false && proc_timed_out(result) == false && proc_exitcode(result) == 125 {
        return {
            "ok": false,
            "stage": "starting",
            "error": process_error(result, "start Docker container " + policy["container_name"]),
            "container_name": policy["container_name"]
        }
    }
    return {
        "ok": true,
        "success": proc_success(result),
        "exit_code": proc_exitcode(result),
        "stdout": proc_stdout(result),
        "stderr": proc_stderr(result),
        "timed_out": proc_timed_out(result),
        "stdout_truncated": proc_stdout_truncated(result),
        "stderr_truncated": proc_stderr_truncated(result),
        "container_name": policy["container_name"]
    }
}

export func stop_container(container_name) {
    result := docker_result(["docker", "stop", "--time", "10", container_name], 30000)
    if process_ok(result) {
        return {"ok": true, "message": "container stopped gracefully"}
    }
    message := trim(proc_stderr(result))
    if contains(message, "No such container") == 1 || contains(message, "is not running") == 1 {
        return {"ok": true, "message": message}
    }
    return {"ok": false, "message": message, "exit_code": proc_exitcode(result)}
}

export func container_logs(container_name) {
    result := docker_result(["docker", "logs", container_name], 30000)
    if process_ok(result) == false {
        return {"ok": false, "error": process_error(result, "collect container logs")}
    }
    return {"ok": true, "stdout": proc_stdout(result), "stderr": proc_stderr(result)}
}

export func remove_container(container_name) {
    result := docker_result(["docker", "rm", "-f", container_name], 30000)
    if process_ok(result) {
        return {"ok": true, "message": "container removed"}
    }
    return {"ok": false, "message": trim(proc_stderr(result)), "exit_code": proc_exitcode(result)}
}

export func clean_owned_resources() {
    listed := docker_result(["docker", "ps", "-aq", "--filter", "label=dev.kujo.workcell=true"], 30000)
    if process_ok(listed) == false {
        return {"ok": false, "error": process_error(listed, "docker list Workcell resources")}
    }
    ids := lines_of(trim(proc_stdout(listed)))
    mut removed := 0
    mut failed := []
    mut i := 0
    while i < len(ids) {
        id := trim(ids[i])
        if id != "" {
            result := remove_container(id)
            if result["ok"] {
                removed = removed + 1
            } else {
                failed = push(failed, id + ": " + result["message"])
            }
        }
        i = i + 1
    }
    return {"ok": len(failed) == 0, "removed": removed, "failed": failed}
}
