# Declarative post-run checks executed inside the same disposable workspace policy.

from src.runtime.docker import container_logs, remove_container, run_container, stop_container
from src.policy.policy import build_policy
from src.util import get_or, redact_with_env

func verification_definition(definition, command) {
    mut value := parse_json(to_json(definition))
    value["command"] := command
    return value
}

func check_result(check, container, cleanup_status) {
    mut status := "passed"
    if get_or(container, "timed_out", false) {
        status = "timeout"
    } else if get_or(container, "success", false) == false {
        status = "failed"
    }
    return {
        "name": check["name"],
        "command": check["command"],
        "status": status,
        "exit_code": get_or(container, "exit_code", 5),
        "stdout": redact_with_env(get_or(container, "stdout", ""), []),
        "stderr": redact_with_env(get_or(container, "stderr", ""), []),
        "stdout_truncated": get_or(container, "stdout_truncated", false),
        "stderr_truncated": get_or(container, "stderr_truncated", false),
        "cleanup_status": cleanup_status
    }
}

export func run_verification_checks(definition, workspace, run_identifier, secrets, workload_succeeded) {
    checks := get_or(definition["verification"], "commands", [])
    mut results := []
    if workload_succeeded == false {
        mut skipped_i := 0
        while skipped_i < len(checks) {
            results = push(results, {"name": checks[skipped_i]["name"], "command": checks[skipped_i]["command"], "status": "skipped", "exit_code": null, "stdout": "", "stderr": "workload did not succeed", "stdout_truncated": false, "stderr_truncated": false, "cleanup_status": "not-run"})
            skipped_i = skipped_i + 1
        }
        return {"ok": false, "checks": results, "error": "verification checks skipped because the workload failed"}
    }
    mut i := 0
    while i < len(checks) {
        check := checks[i]
        check_definition := verification_definition(definition, check["command"])
        check_id := run_identifier + "-verify-" + to_string(i)
        policy := build_policy(check_definition, check_id, workspace["workspace_path"])
        if policy["ok"] == false {
            results = push(results, {"name": check["name"], "command": check["command"], "status": "blocked", "exit_code": null, "stdout": "", "stderr": policy["error"], "stdout_truncated": false, "stderr_truncated": false, "cleanup_status": "not-started"})
            return {"ok": false, "checks": results, "error": "could not build verification policy for " + check["name"]}
        }
        container := run_container(check_definition, policy)
        if container["ok"] == false {
            results = push(results, {"name": check["name"], "command": check["command"], "status": "blocked", "exit_code": null, "stdout": "", "stderr": redact_with_env(container["error"], secrets), "stdout_truncated": false, "stderr_truncated": false, "cleanup_status": "not-started"})
            return {"ok": false, "checks": results, "error": "verification could not start: " + check["name"]}
        }
        mut stdout := redact_with_env(get_or(container, "stdout", ""), secrets)
        mut stderr := redact_with_env(get_or(container, "stderr", ""), secrets)
        if get_or(container, "timed_out", false) {
            logs := container_logs(policy["container_name"])
            if logs["ok"] {
                stdout = redact_with_env(logs["stdout"], secrets)
                stderr = redact_with_env(logs["stderr"], secrets)
            }
        }
        mut stop_result := {"ok": true}
        if get_or(container, "timed_out", false) {
            stop_result = stop_container(policy["container_name"])
        }
        cleanup := remove_container(policy["container_name"])
        mut cleanup_status := "complete"
        if stop_result["ok"] == false || cleanup["ok"] == false {
            cleanup_status = "failed"
        }
        result := check_result(check, container, cleanup_status)
        result["stdout"] := stdout
        result["stderr"] := stderr
        results = push(results, result)
        if result["status"] != "passed" || cleanup_status != "complete" {
            return {"ok": false, "checks": results, "error": "verification check failed: " + check["name"]}
        }
        i = i + 1
    }
    return {"ok": true, "checks": results}
}
