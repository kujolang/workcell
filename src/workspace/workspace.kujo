# Disposable Git workspace management.

from src.util import ensure_dir, get_or, has_key_safe, lines_of, path_has_symlink, path_within, process_error, process_ok, proc_exitcode, proc_stderr, proc_stdout, run_argv, save_json, write_text

export func temp_root() {
    candidate := env("TMPDIR")
    if type(candidate) != "string" || trim(candidate) == "" {
        return "/tmp"
    }
    mut normalized := replace(candidate, "\\", "/")
    while len(normalized) > 1 && ends_with(normalized, "/") {
        normalized = substring(normalized, 0, len(normalized) - 1)
    }
    if starts_with(normalized, "/") == false || normalized == "/" || contains(normalized, "..") == 1 || path_has_symlink(normalized) {
        return "/tmp"
    }
    return normalized
}

func git_result(args, timeout_ms) {
    return run_argv(args, timeout_ms)
}

export func inspect_repository(repo_path) {
    root_result := git_result(["git", "-C", repo_path, "rev-parse", "--show-toplevel"], 10000)
    if process_ok(root_result) == false {
        return {"ok": false, "error": "not a Git repository: " + repo_path}
    }
    root := trim(proc_stdout(root_result))
    commit_result := git_result(["git", "-C", root, "rev-parse", "HEAD"], 10000)
    if process_ok(commit_result) == false {
        return {"ok": false, "error": process_error(commit_result, "resolve source commit")}
    }
    status_result := git_result(["git", "-C", root, "status", "--porcelain", "--untracked-files=all"], 10000)
    if process_ok(status_result) == false {
        return {"ok": false, "error": process_error(status_result, "inspect repository status")}
    }
    return {
        "ok": true,
        "root": root,
        "commit": trim(proc_stdout(commit_result)),
        "status": trim(proc_stdout(status_result)),
        "clean": trim(proc_stdout(status_result)) == ""
    }
}

export func find_symlink(root) {
    mut queue := [root]
    mut queue_i := 0
    while queue_i < len(queue) {
        current := queue[queue_i]
        entries := list_dir(current)
        mut entry_i := 0
        while entry_i < len(entries) {
            name := to_string(entries[entry_i])
            candidate := current + "/" + name
            mut is_link := false
            try {
                is_link = path_is_symlink(candidate)
            } except err {
                is_link = false
            }
            if is_link {
                return {"ok": false, "path": candidate, "error": "symlink is not allowed in a Workcell workspace: " + candidate}
            }
            if path_is_dir(candidate) {
                queue = push(queue, candidate)
            }
            entry_i = entry_i + 1
        }
        queue_i = queue_i + 1
    }
    return {"ok": true}
}

export func create_workspace(repo_path, strategy, run_identifier) {
    inspected := inspect_repository(repo_path)
    if inspected["ok"] == false {
        return inspected
    }
    if inspected["clean"] == false {
        return {"ok": false, "stage": "preparing", "error": "source repository is dirty; Workcell rejects dirty repositories by default to avoid omitting user changes", "status": inspected["status"]}
    }
    root := inspected["root"]
    path := temp_root() + "/kujo-workcell-" + run_identifier
    if path_is_dir(path) || file_exists(path) {
        return {"ok": false, "stage": "preparing", "error": "temporary workspace already exists: " + path}
    }
    parent := path
    mut slash := len(parent) - 1
    while slash >= 0 {
        if substring(parent, slash, slash + 1) == "/" {
            parent = substring(parent, 0, slash)
            break
        }
        slash = slash - 1
    }
    ensure_dir(parent)
    mut result := null
    if strategy == "git-worktree" {
        result = git_result(["git", "-C", root, "worktree", "add", "--detach", path, inspected["commit"]], 60000)
    } else {
        result = git_result(["git", "clone", "--no-local", root, path], 120000)
    }
    if process_ok(result) == false {
        return {"ok": false, "stage": "preparing", "error": process_error(result, "create disposable " + strategy), "stdout": proc_stdout(result), "stderr": proc_stderr(result)}
    }
    write_text(path + ".owner", "workcell-run-id=" + run_identifier + "\n")
    symlinks := find_symlink(path)
    if symlinks["ok"] == false {
        cleanup_workspace({"workspace_path": path, "source_root": root, "strategy": strategy}, false)
        return {"ok": false, "stage": "preparing", "error": symlinks["error"]}
    }
    permissions := run_argv(["chmod", "-R", "a+rwX", path], 60000)
    if process_ok(permissions) == false {
        cleanup_workspace({"workspace_path": path, "source_root": root, "strategy": strategy}, false)
        return {"ok": false, "stage": "preparing", "error": process_error(permissions, "make disposable workspace writable")}
    }
    return {
        "ok": true,
        "source_root": root,
        "source_commit": inspected["commit"],
        "workspace_path": path,
        "strategy": strategy,
        "source_clean": true
    }
}

func status_name(letter) {
    if letter == "A" {
        return "added"
    }
    if letter == "D" {
        return "deleted"
    }
    if letter == "R" {
        return "renamed"
    }
    if letter == "C" {
        return "copied"
    }
    return "modified"
}

func change_summary(files) {
    mut summary := {"total_files": len(files), "added": 0, "modified": 0, "deleted": 0, "renamed": 0, "copied": 0, "binary_files": 0}
    mut i := 0
    while i < len(files) {
        status := files[i]["status"]
        if status == "added" {
            summary["added"] = summary["added"] + 1
        } else if status == "modified" {
            summary["modified"] = summary["modified"] + 1
        } else if status == "deleted" {
            summary["deleted"] = summary["deleted"] + 1
        } else if status == "renamed" {
            summary["renamed"] = summary["renamed"] + 1
        } else if status == "copied" {
            summary["copied"] = summary["copied"] + 1
        }
        if get_or(files[i], "binary", false) == true {
            summary["binary_files"] = summary["binary_files"] + 1
        }
        i = i + 1
    }
    return summary
}

func change_details(workspace) {
    status_result := git_result(["git", "-C", workspace["workspace_path"], "diff", "--name-status", workspace["source_commit"]], 30000)
    if process_ok(status_result) == false {
        return {"ok": false, "error": process_error(status_result, "collect changed files")}
    }
    lines := lines_of(trim(proc_stdout(status_result)))
    mut files := []
    mut i := 0
    while i < len(lines) {
        line := trim(lines[i])
        if line != "" {
            columns := split(line, "\t")
            letter := substring(columns[0], 0, 1)
            files = push(files, {"path": columns[len(columns) - 1], "status": status_name(letter), "binary": false})
        }
        i = i + 1
    }
    untracked_result := git_result(["git", "-C", workspace["workspace_path"], "ls-files", "--others", "--exclude-standard"], 30000)
    if process_ok(untracked_result) {
        untracked := lines_of(trim(proc_stdout(untracked_result)))
        mut j := 0
        while j < len(untracked) {
            item := trim(untracked[j])
            if item != "" {
                exists := false
                mut k := 0
                while k < len(files) {
                    if files[k]["path"] == item {
                        exists = true
                    }
                    k = k + 1
                }
                if exists == false {
                    binary := false
                    untracked_numstat := git_result(["git", "-C", workspace["workspace_path"], "diff", "--numstat", "--no-index", "--", "/dev/null", item], 30000)
                    if proc_exitcode(untracked_numstat) == 1 {
                        untracked_columns := split(trim(proc_stdout(untracked_numstat)), "\t")
                        if len(untracked_columns) >= 2 && untracked_columns[0] == "-" && untracked_columns[1] == "-" {
                            binary = true
                        }
                    }
                    files = push(files, {"path": item, "status": "added", "binary": binary})
                }
            }
            j = j + 1
        }
    }
    numstat_result := git_result(["git", "-C", workspace["workspace_path"], "diff", "--numstat", workspace["source_commit"]], 30000)
    if process_ok(numstat_result) {
        numstat_lines := lines_of(trim(proc_stdout(numstat_result)))
        binary_paths := {}
        mut numstat_i := 0
        while numstat_i < len(numstat_lines) {
            numstat_columns := split(trim(numstat_lines[numstat_i]), "\t")
            if len(numstat_columns) >= 3 {
                numstat_path := numstat_columns[len(numstat_columns) - 1]
                if numstat_columns[0] == "-" && numstat_columns[1] == "-" {
                    binary_paths[numstat_path] := true
                }
            }
            numstat_i = numstat_i + 1
        }
        mut file_i := 0
        while file_i < len(files) {
            if has_key_safe(binary_paths, files[file_i]["path"]) {
                files[file_i]["binary"] := true
            }
            file_i = file_i + 1
        }
    }
    return {"ok": true, "files": files, "summary": change_summary(files)}
}

export func changed_files(workspace) {
    details := change_details(workspace)
    if details["ok"] == false {
        return details
    }
    mut paths := []
    mut i := 0
    while i < len(details["files"]) {
        paths = push(paths, details["files"][i]["path"])
        i = i + 1
    }
    return {"ok": true, "files": paths}
}

export func write_change_report(workspace, output_path, patch_bytes) {
    details := change_details(workspace)
    if details["ok"] == false {
        return details
    }
    try {
        save_json(output_path, {"source_commit": workspace["source_commit"], "patch_bytes": patch_bytes, "summary": details["summary"], "files": details["files"]})
    } except err {
        return {"ok": false, "error": "could not write change report: " + to_string(err)}
    }
    return {"ok": true, "path": output_path, "files": details["files"]}
}

export func make_patch(workspace, patch_path) {
    result := git_result(["git", "-C", workspace["workspace_path"], "diff", "--binary", workspace["source_commit"]], 60000)
    if process_ok(result) == false {
        return {"ok": false, "error": process_error(result, "generate Git patch")}
    }
    mut patch_text := proc_stdout(result)
    untracked_result := git_result(["git", "-C", workspace["workspace_path"], "ls-files", "--others", "--exclude-standard"], 30000)
    if process_ok(untracked_result) == false {
        return {"ok": false, "error": process_error(untracked_result, "collect untracked files for Git patch")}
    }
    untracked := lines_of(trim(proc_stdout(untracked_result)))
    mut i := 0
    while i < len(untracked) {
        relative := trim(untracked[i])
        if relative != "" {
            added := git_result(["git", "-C", workspace["workspace_path"], "diff", "--binary", "--no-index", "--", "/dev/null", relative], 60000)
            if proc_exitcode(added) != 0 && proc_exitcode(added) != 1 {
                return {"ok": false, "error": process_error(added, "generate Git patch for " + relative)}
            }
            patch_text = patch_text + proc_stdout(added)
        }
        i = i + 1
    }
    if file_exists(patch_path) {
        delete_file(patch_path)
    }
    try {
        write_file(patch_path, patch_text)
    } except err {
        return {"ok": false, "error": "could not write Git patch: " + to_string(err)}
    }
    return {"ok": true, "path": patch_path, "bytes": len(patch_text)}
}

export func cleanup_workspace(workspace, preserve) {
    if preserve {
        return {"ok": true, "preserved": true, "path": workspace["workspace_path"], "message": "failed workspace preserved by policy"}
    }
    path := workspace["workspace_path"]
    if starts_with(path, temp_root() + "/kujo-workcell-") == false {
        return {"ok": false, "error": "refusing to remove workspace outside Workcell temporary root: " + path}
    }
    owner_path := path + ".owner"
    if file_exists(owner_path) == false {
        return {"ok": false, "error": "refusing to remove an unowned Workcell temporary path: " + path}
    }
    mut result := null
    if workspace["strategy"] == "git-worktree" {
        result = git_result(["git", "-C", workspace["source_root"], "worktree", "remove", "--force", path], 60000)
    } else {
        result = run_argv(["rm", "-rf", path], 60000)
    }
    if process_ok(result) == false && (path_is_dir(path) || file_exists(path)) {
        return {"ok": false, "error": process_error(result, "clean disposable workspace")}
    }
    owner_result := run_argv(["rm", "-f", owner_path], 30000)
    if process_ok(owner_result) == false {
        return {"ok": false, "error": process_error(owner_result, "remove Workcell ownership marker")}
    }
    return {"ok": true, "preserved": false, "path": path}
}

export func clean_stale_workspaces() {
    root := temp_root()
    if path_is_dir(root) == false {
        return {"ok": true, "removed": [], "skipped": []}
    }
    entries := list_dir(root)
    mut removed := []
    mut skipped := []
    mut i := 0
    while i < len(entries) {
        name := to_string(entries[i])
        if starts_with(name, "kujo-workcell-") && ends_with(name, ".owner") == false {
            path := root + "/" + name
            owner_path := path + ".owner"
            if file_exists(owner_path) && path_is_symlink(path) == false && path_is_dir(path) {
                result := run_argv(["rm", "-rf", path], 60000)
                if process_ok(result) {
                    run_argv(["rm", "-f", owner_path], 30000)
                    removed = push(removed, path)
                } else {
                    skipped = push(skipped, path + ": " + trim(proc_stderr(result)))
                }
            } else if starts_with(name, "kujo-workcell-") && path_is_dir(path) {
                skipped = push(skipped, path + ": ownership marker missing or path is a symlink")
            }
        }
        i = i + 1
    }
    return {"ok": len(skipped) == 0, "removed": removed, "skipped": skipped}
}
