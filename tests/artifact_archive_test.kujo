from src.artifacts.archive import accept_remote_artifact_archive, artifact_archive_schema_version, create_artifact_archive, materialize_artifact_archive
from src.workspace.workspace import temp_root

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
        failed = failed + 1
        print("FAIL " + label)
    }
}

root := temp_root() + "/workcell-artifact-archive-test-" + replace(uuid_v4(), "-", "")
workspace := root + "/workspace"
output := root + "/package"
target := root + "/target"
spawn_process(["mkdir", "-p", workspace + "/reports"])
write_file_atomic(workspace + "/reports/result.txt", "verified result\n", true)
write_file_atomic(workspace + "/undeclared.txt", "must not export\n", true)
policy := {"export": ["reports"], "limits": {}, "max_bytes": 100000, "max_files": 10, "max_depth": 8, "allowed_extensions": [".txt"], "secret_action": "allow"}

package := create_artifact_archive(workspace, output, policy, [])
expect("declared artifacts create bounded archive", package["ok"])
expect("artifact archive uses versioned schema", package["schema_version"] == artifact_archive_schema_version())
expect("artifact manifest contains only declared path", package["manifest"]["files"][0]["path"] == "reports/result.txt")
expect("artifact staging is removed after archive", path_is_dir(output + "/" + package["manifest"]["root_name"]) == false)

materialized := materialize_artifact_archive(package, target, policy)
expect("artifact archive materializes and verifies", materialized["ok"])
expect("materialized artifact content exists", file_exists(materialized["artifact_root"] + "/reports/result.txt"))
expect("undeclared workspace content is absent", file_exists(materialized["artifact_root"] + "/undeclared.txt") == false)

remote_source := root + "/remote-source"
remote_archive := root + "/remote-transfer/artifacts.tar"
spawn_process(["mkdir", "-p", remote_source + "/reports", root + "/remote-transfer"])
write_file_atomic(remote_source + "/reports/result.txt", "remote result\n", true)
write_file_atomic(remote_source + "/undeclared.txt", "remote secret\n", true)
spawn_process(["tar", "-cf", remote_archive, "-C", remote_source, "reports"])
accepted := accept_remote_artifact_archive(remote_archive, root + "/accepted", policy, [])
expect("remote archive is re-exported through core policy", accepted["ok"]&&accepted["manifest"]["files"][0]["path"] == "reports/result.txt")
expect("remote archive receives a local integrity digest", len(accepted["sha256"]) == 64)

wrong_policy := {"export": ["undeclared.txt"], "limits": {}, "max_bytes": 100000, "max_files": 10, "max_depth": 8, "allowed_extensions": [".txt"], "secret_action": "allow"}
expect("artifact materialization rejects declaration mismatch", materialize_artifact_archive(package, root + "/wrong-target", wrong_policy)["ok"] == false)

mut tampered := package
tampered_path := root + "/tampered.tar"
write_file_atomic(tampered_path, "tampered", true)
tampered["archive_path"] := tampered_path
expect("artifact archive digest mismatch fails before extraction", materialize_artifact_archive(tampered, root + "/tampered-target", policy)["ok"] == false)

spawn_process(["rm", "-rf", root])
print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {exit(1)}
