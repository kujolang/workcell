from src.backend.client import invoke_backend, parse_backend_frames
from src.backend.fixture import fixture_dispatch
from src.backend.oci.docker import docker_identity
from src.backend.oci.driver import builtin_backend_identity, builtin_backend_valid
from src.backend.oci.podman import podman_identity
from src.backend.registry import backend_executable, load_backend_manifest, load_backend_registry, registry_backend, validate_backend_credential_ref, validate_backend_manifest
from src.backend.resolution import capability_state_by_id, resolve_capabilities, validate_capability_implications
from src.backend.types import backend_contract_id, backend_handle, backend_identity, capability_state, terminal_result, validate_backend_handle, validate_backend_identity, validate_capability_state, validate_protocol_request, validate_protocol_result, validate_terminal_result
from src.domain.definition import default_definition
from src.util import get_or, run_argv

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
        failed = failed + 1
        print("FAIL " + label)
    }
}

run_identifier := "wc-0123456789abcdef0123456789abcdef"
identity := backend_identity("fixture", "1.0.0", "fixture", "fixture/v1", "process")
expect("backend identity validates", validate_backend_identity(identity)["ok"])
expect("backend identity rejects missing provider", validate_backend_identity({"adapter": "fixture"})["ok"] == false)

mut docker_definition := default_definition()
mut podman_definition := default_definition()
mut podman_runtime := podman_definition["runtime"]
podman_runtime["backend"] := "podman"
podman_runtime["engine_runtime"] := "crun"
podman_definition["runtime"] := podman_runtime
expect("docker is a built-in backend", builtin_backend_valid("docker"))
expect("podman is a built-in backend", builtin_backend_valid("podman"))
expect("unknown backend is not built in", builtin_backend_valid("e2b") == false)
expect("docker adapter identity separates provider and substrate", docker_identity(docker_definition)["provider"] == "docker-engine"&&docker_identity(docker_definition)["substrate"] == "oci/runc")
expect("podman adapter identity records selected substrate", podman_identity(podman_definition)["provider"] == "podman-engine"&&podman_identity(podman_definition)["substrate"] == "oci/crun")
expect("built-in identity dispatches by backend", builtin_backend_identity(podman_definition)["adapter"] == "podman")

state := capability_state("network.none", "supported", true, "accepted", {"mode": "deny-all"}, {"status": "provider-claimed", "authority": "fixture", "evidence": "deny"}, {"status": "observed", "method": "probe", "result": "blocked"}, [])
expect("capability state validates", validate_capability_state(state)["ok"])
expect("capability state rejects invalid enforcement", validate_capability_state(capability_state("network.none", "supported", true, "accepted", {}, {"status": "enforced"}, {"status": "observed"}, []))["ok"] == false)
expect("accepted capability rejects unknown enforcement", validate_capability_state(capability_state("network.none", "supported", true, "accepted", {"mode": "deny-all"}, {"status": "unknown", "authority": "fixture", "evidence": ""}, {"status": "not-observed", "method": "", "result": ""}, []))["ok"] == false)

handle := backend_handle("fixture", "1.0.0", "fixture", "sha256:fixture", [{"kind": "fixture", "id": "fixture-1"}], run_identifier, "nonce-1", {})
expect("backend handle validates ownership", validate_backend_handle(handle, run_identifier)["ok"])
expect("backend handle rejects run mismatch", validate_backend_handle(handle, "wc-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")["ok"] == false)
unsafe_handle := parse_json(to_json(handle))
unsafe_handle["provider_state"] := {"signed_url": "https://objects.invalid/file?X-Amz-Signature=secret"}
expect("backend handle rejects signed transport material", validate_backend_handle(unsafe_handle, run_identifier)["ok"] == false)
oversized_handle := parse_json(to_json(handle))
oversized_handle["provider_state"] := {"value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}
mut oversized_value := oversized_handle["provider_state"]["value"]
while len(oversized_value) < 70000 {oversized_value = oversized_value + oversized_value}
oversized_handle["provider_state"] := {"value": oversized_value}
expect("backend handle rejects oversized provider state", validate_backend_handle(oversized_handle, run_identifier)["ok"] == false)

terminal := terminal_result("exited", 0, null, "complete", false, false, "terminal")
expect("terminal result validates", validate_terminal_result(terminal)["ok"])
expect("unknown status cannot claim terminal certainty", validate_terminal_result(terminal_result("unknown", null, null, "disconnect", false, false, "terminal"))["ok"] == false)

enforcement := {"status": "provider-claimed", "authority": "fixture", "evidence": "configured"}
observation := {"status": "not-observed", "method": "", "result": ""}
capabilities := {
    "network.none": {"support": "supported", "resolved": {"mode": "deny-all"}, "enforcement": enforcement, "observation": observation, "limitations": []},
    "compute.pid_limit": {"support": "unknown", "enforcement": {"status": "unknown"}, "observation": observation, "limitations": ["provider does not report PID controls"]},
    "metrics.cpu": {"support": "unsupported", "enforcement": {"status": "unsupported"}, "observation": observation, "limitations": []}
}
strict := resolve_capabilities([{"id": "network.none", "requested": true, "required": true, "value": {"mode": "none"}}], capabilities)
expect("supported strict capability resolves", strict["ok"]&&capability_state_by_id(strict["states"], "network.none")["acceptance"] == "accepted")
expect("capability resolution preserves requested semantic value", to_json(capability_state_by_id(strict["states"], "network.none")["resolved"]) == to_json({"mode": "none"}))
unknown := resolve_capabilities([{"id": "compute.pid_limit", "requested": true, "required": true, "value": 64}], capabilities)
expect("unknown required capability fails closed", unknown["ok"] == false&&unknown["rejected"][0] == "compute.pid_limit")
degraded := resolve_capabilities([{"id": "metrics.cpu", "requested": true, "required": false, "allow_degradation": true}], capabilities)
expect("explicit metrics degradation is visible", degraded["ok"]&&degraded["degraded"][0] == "metrics.cpu")
security_degrade := resolve_capabilities([{"id": "network.none", "requested": true, "required": false, "allow_degradation": true}], {"network.none": {"support": "unsupported"}})
expect("security control cannot use evidence degradation", security_degrade["ok"] == false)
expect("pause requires resume", validate_capability_implications({"lifecycle.pause": {"support": "supported"}})["ok"] == false)

request := {
    "contract": backend_contract_id(),
    "request_id": "request-1",
    "run_id": run_identifier,
    "operation": "describe",
    "deadline_ms": 1000,
    "profile": {},
    "payload": {}
}
expect("protocol request validates", validate_protocol_request(request)["ok"])
unexpected_request := {"contract": backend_contract_id(), "request_id": "request-unknown", "run_id": run_identifier, "operation": "describe", "deadline_ms": 1000, "profile": {}, "payload": {}, "vendor": true}
expect("protocol request rejects unknown envelope fields", validate_protocol_request(unexpected_request)["ok"] == false)
describe := fixture_dispatch(request)
expect("fixture describe succeeds offline", describe["ok"]&&describe["data"]["adapter"]["id"] == "fixture")

request["operation"] := "resolve"
request["payload"] := {"requirements": [{"id": "network.none", "requested": true, "required": true}], "intent": {"command": ["true"]}}
resolved := fixture_dispatch(request)
expect("fixture resolves required capability", resolved["ok"]&&resolved["data"]["capabilities"][0]["acceptance"] == "accepted")

request["operation"] := "provision"
request["payload"] := {"ownership": {"run_id": run_identifier, "nonce": "nonce-1"}, "resolved_plan": resolved["data"]["resolved_plan"], "idempotency_key": run_identifier + ":provision"}
provisioned := fixture_dispatch(request)
expect("fixture provisions owned handle", provisioned["ok"]&&validate_backend_handle(provisioned["data"]["handle"], run_identifier)["ok"])

request["operation"] := "prepare"
request["payload"] := {"handle": provisioned["data"]["handle"], "workspace_package": {"sha256": "sha256:fixture"}, "idempotency_key": run_identifier + ":prepare"}
prepared := fixture_dispatch(request)
expect("fixture verifies workspace package digest", prepared["ok"]&&prepared["data"]["observed_package_digest"] == "sha256:fixture")

request["operation"] := "execute"
request["profile"] := {"execution": {"exit_code": 7, "stdout": "hello", "stderr": "warning"}}
request["payload"] := {"handle": provisioned["data"]["handle"], "attempt_id": "attempt-1", "argv": ["false"], "workdir": "/workspace", "environment": {}, "secret_channel": [], "timeout_ms": 1000, "max_output_bytes": 65536}
executed := fixture_dispatch(request)
expect("fixture preserves workload non-zero exit as protocol success", executed["ok"]&&executed["data"]["terminal"]["exit_code"] == 7)

request["operation"] := "export"
request["payload"] := {"handle": provisioned["data"]["handle"], "declarations": ["out.txt"], "limits": {"max_bytes": 1024, "max_files": 1}, "exporter_version": "workcell-artifacts/v1", "destination": "/tmp/workcell-backend-test", "idempotency_key": run_identifier + ":export"}
exported := fixture_dispatch(request)
expect("fixture exports only declarations", exported["ok"]&&exported["data"]["manifest"]["declared"][0] == "out.txt")

request["operation"] := "destroy"
request["payload"] := {"handle": provisioned["data"]["handle"], "expected_ownership": provisioned["data"]["handle"]["ownership"], "idempotency_key": run_identifier + ":destroy"}
destroyed := fixture_dispatch(request)
expect("fixture destroy is itemized", destroyed["ok"]&&destroyed["data"]["items"][0]["status"] == "removed")

manifest_path := "tests/fixtures/backend-protocol/manifest.json"
manifest := load_backend_manifest(manifest_path)
expect("external backend manifest validates", manifest["ok"]&&manifest["manifest"]["id"] == "external-fixture")
registry := load_backend_registry([manifest_path])
expect("registry resolves explicit manifest", registry["ok"]&&registry_backend(registry, "external-fixture")["adapter_version"] == "1.0.0")
external_executable := backend_executable(manifest["manifest"])
expect("registry resolves executable relative to manifest", external_executable["ok"]&&ends_with(get_or(external_executable, "path", ""), "/workcell-backend-fixture"))
expect("registry rejects duplicate backend ids", load_backend_registry([manifest_path, manifest_path])["ok"] == false)
credential_manifest := parse_json(to_json(manifest["manifest"]))
credential_manifest["credential_refs"] := ["env:E2B_API_KEY"]
expect("registry accepts an explicitly advertised credential reference", validate_backend_credential_ref(credential_manifest, "env:E2B_API_KEY")["ok"])
expect("registry rejects an unadvertised credential-store bridge", validate_backend_credential_ref(credential_manifest, "kujo-agent:e2b")["ok"] == false)
invalid_manifest := manifest["manifest"]
invalid_manifest["unknown"] := true
expect("backend manifest rejects unknown fields", validate_backend_manifest(invalid_manifest)["ok"] == false)

external_request := {
    "contract": backend_contract_id(),
    "request_id": "external-request-1",
    "run_id": run_identifier,
    "operation": "describe",
    "deadline_ms": 5000,
    "profile": {},
    "payload": {}
}
external := invoke_backend(external_executable["path"], external_request, {"timeout_ms": 30000, "max_output_bytes": 65536})
expect("external JSONL adapter executes through bounded client", external["ok"]&&len(external["events"]) == 0&&external["result"]["data"]["adapter"]["id"] == "external-fixture")

external_request["profile"] := {"mode": "noise"}
noise := invoke_backend(external_executable["path"], external_request, {"timeout_ms": 30000, "max_output_bytes": 65536})
expect("external adapter stdout noise is a protocol violation", noise["ok"] == false&&noise["result"]["error"]["code"] == "PROTOCOL_VIOLATION")

external_request["profile"] := {"mode": "duplicate-result"}
duplicate := invoke_backend(external_executable["path"], external_request, {"timeout_ms": 30000, "max_output_bytes": 65536})
expect("external adapter duplicate result is rejected", duplicate["ok"] == false&&duplicate["result"]["error"]["code"] == "PROTOCOL_VIOLATION")

wrong_echo := to_json({"contract": backend_contract_id(), "request_id": "wrong", "run_id": run_identifier, "operation": "describe", "type": "result", "ok": true, "status": "ok", "retryable": false, "data": {}})
expect("protocol parser rejects request echo mismatch", parse_backend_frames(external_request, wrong_echo, {})["ok"] == false)
invalid_success := {"contract": backend_contract_id(), "request_id": external_request["request_id"], "run_id": run_identifier, "operation": "describe", "type": "result", "ok": true, "status": "ok", "retryable": false, "data": {}}
expect("protocol validator rejects invalid operation result data", validate_protocol_result(external_request, invalid_success)["ok"] == false)
expect("protocol parser rejects invalid operation result data", parse_backend_frames(external_request, to_json(invalid_success), {})["ok"] == false)
invalid_failure := {"contract": backend_contract_id(), "request_id": external_request["request_id"], "run_id": run_identifier, "operation": "describe", "type": "result", "ok": false, "status": "failed", "retryable": false, "data": {}}
expect("protocol validator requires structured failure error", validate_protocol_result(external_request, invalid_failure)["ok"] == false)

secret := "portable-secret-value"
log_frame := {"contract": backend_contract_id(), "request_id": external_request["request_id"], "run_id": run_identifier, "operation": "describe", "type": "event", "event": "log", "sequence": 0, "stream": "stdout", "bytes_base64": encode_base64("token=" + secret), "provider_timestamp": null, "ordering": "per-stream"}
result_frame := {"contract": backend_contract_id(), "request_id": external_request["request_id"], "run_id": run_identifier, "operation": "describe", "type": "result", "ok": false, "status": "failed", "retryable": false, "data": {"diagnostic": secret}, "error": {"code": "TEST", "message": "failed with " + secret, "provider_code": secret}}
redacted_frames := parse_backend_frames(external_request, to_json(log_frame) + "\n" + to_json(result_frame), {"redact_values": [secret]})
redacted_log := decode_base64_utf8(redacted_frames["events"][0]["bytes_base64"])
expect("protocol parser redacts decoded workload logs", contains(redacted_log, secret) == 0&&contains(redacted_log, "[REDACTED]") == 1)
expect("protocol parser redacts result diagnostics recursively", contains(to_json(redacted_frames["result"]), secret) == 0)

split_first := log_frame
split_first["bytes_base64"] = encode_base64("token=portable-")
split_second := log_frame
split_second["sequence"] = 1
split_second["bytes_base64"] = encode_base64("secret-value")
split_frames := parse_backend_frames(external_request, to_json(split_first) + "\n" + to_json(split_second) + "\n" + to_json(result_frame), {"redact_values": [secret]})
split_log := decode_base64_utf8(split_frames["events"][0]["bytes_base64"])
expect("protocol parser redacts secrets split across log events", contains(split_log, secret) == 0&&contains(split_log, "[REDACTED]") == 1)

invalid_log := log_frame
invalid_log["bytes_base64"] = "/w=="
expect("protocol parser rejects non-UTF-8 log bytes", parse_backend_frames(external_request, to_json(invalid_log) + "\n" + to_json(result_frame), {"redact_values": [secret]})["ok"] == false)

cancel_file := "/tmp/workcell-backend-cancel-" + replace(uuid_v4(), "-", "")
write_file_atomic(cancel_file, "cancel\n", true)
external_request["profile"] := {"mode": "hang"}
cancelled_call := invoke_backend(external_executable["path"], external_request, {"timeout_ms": 30000, "max_output_bytes": 65536, "cancel_file": cancel_file})
expect("backend client classifies operator cancellation", cancelled_call["ok"] == false&&cancelled_call["result"]["error"]["code"] == "ADAPTER_CANCELLED")
run_argv(["rm", "-f", cancel_file], 5000)
timed_call := invoke_backend(external_executable["path"], external_request, {"timeout_ms": 250, "max_output_bytes": 65536})
expect("backend client classifies adapter timeout", timed_call["ok"] == false&&timed_call["result"]["error"]["code"] == "ADAPTER_TIMEOUT")

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {exit(1)}
