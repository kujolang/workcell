from src.backend.conformance import conformance_schema_version, run_backend_conformance

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
    failed = failed + 1
    print("FAIL " + label)
}
}

report := run_backend_conformance("tests/fixtures/backend-protocol/manifest.json", {"nonce": "ignored"}, "wc-33333333333333333333333333333333")
expect("external fixture passes base conformance", report["ok"])
expect("conformance report is versioned", report["schema_version"] == conformance_schema_version())
expect("conformance covers complete mandatory lifecycle", len(report["checks"]) == 9)
expect("conformance identifies adapter", report["adapter_id"] == "external-fixture")

invalid := run_backend_conformance("tests/fixtures/backend-protocol/missing.json", {}, "wc-44444444444444444444444444444444")
expect("conformance fails safely for missing manifest", invalid["ok"] == false&&invalid["failed_operation"] == "manifest")

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {exit(1)}
