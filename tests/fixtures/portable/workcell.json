{
  "schema": "workcell-definition/v2alpha1",
  "name": "portable-fixture",
  "workload": {
    "kind": "linux-process",
    "image": {"reference": "alpine:3.20", "digest": "", "signature_key": ""},
    "command": ["sh", "-lc", "printf fixture"],
    "working_directory": "/workspace"
  },
  "workspace": {"source": "clean-git-commit", "materialization": "portable-clone", "mount_path": "/workspace"},
  "environment": {"allow": [], "set": {}},
  "secrets": [],
  "requirements": {
    "compute": {"cpus": 1, "memory": "512m", "pids": 64},
    "execution": {"timeout_ms": 10000, "max_output_bytes": 65536},
    "network": {"mode": "none"},
    "filesystem": {"read_only_root": true, "writable": ["/workspace"], "tmpfs": ["/tmp"]}
  },
  "artifacts": {"export": []},
  "verification": {"version": 1, "commands": []},
  "cleanup": {"keep_failed": false},
  "receipt": {"path": ".workcell/runs"}
}
