#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  rm)
    case "${3:-}" in
      missing-no-container) echo "Error response from daemon: no container with name or ID" >&2 ;;
      missing-not-found) echo "container not found" >&2 ;;
      *) echo "Error response from daemon: No such container" >&2 ;;
    esac
    exit 1
    ;;
  stop)
    case "${4:-}" in
      missing-no-container) echo "Error response from daemon: no container with name or ID" >&2 ;;
      missing-not-found) echo "container not found" >&2 ;;
      *) echo "Error response from daemon: No such container" >&2 ;;
    esac
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
