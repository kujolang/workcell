from src.domain.caller_context import caller_context_schema_version, validate_caller_context
from src.domain.portable_definition import host_profiles_schema_version, load_host_profile, portable_definition_schema_version, resolve_portable_definition, validate_portable_definition, validate_profile_budgets
from src.evidence.controls import requirements_from_definition
from src.execution.portable_oci import inspect_portable_oci, portable_to_legacy
from src.util import run_argv

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {passed = passed + 1; print("PASS " + label)} else {failed = failed + 1; print("FAIL " + label)}
}

func has_requirement(requirements, id) {
    for requirement in requirements {if requirement["id"] == id {return true}}
    return false
}

definition := {
    "schema": portable_definition_schema_version(), "name": "portable-fixture",
    "workload": {"kind": "linux-process", "image": {"reference": "alpine:3.20", "digest": "", "signature_key": ""}, "command": ["sh", "-lc", "printf fixture"], "working_directory": "/workspace"},
    "workspace": {"source": "clean-git-commit", "materialization": "portable-clone", "mount_path": "/workspace"},
    "environment": {"allow": [], "set": {}}, "secrets": [],
    "requirements": {"compute": {"cpus": 1, "memory": "512m", "pids": 64}, "execution": {"timeout_ms": 10000, "max_output_bytes": 65536}, "network": {"mode": "none"}, "filesystem": {"read_only_root": true, "writable": ["/workspace"], "tmpfs": ["/tmp"]}},
    "artifacts": {"export": ["result.txt"], "max_bytes": 1048576, "max_files": 100}, "verification": {"version": 1, "commands": []}, "cleanup": {"keep_failed": false}, "receipt": {"path": ".workcell/runs"}
}

definition_check := validate_portable_definition(definition)
if definition_check["ok"] == false {print(to_json_pretty(definition_check))}
expect("portable definition validates", definition_check["ok"])
resolved := resolve_portable_definition(definition)
expect("portable defaults resolve", resolved["ok"]&&resolved["definition"]["workspace"]["scan"]["max_files"] == 100000)
requirements := requirements_from_definition(resolved["definition"])
expect("portable requirements become semantic capabilities", requirements["ok"]&&len(requirements["requirements"]) >= 20)
local_profile := {"backend": "docker", "credential_ref": "", "region": "", "provider_project": "", "endpoint": "", "adapter_options": {"docker": {"engine_runtime": "runsc", "workspace_run_as": "host"}}, "policy": {}}
legacy := portable_to_legacy(resolved["definition"], "docker", local_profile)
if legacy["ok"] == false {print(to_json_pretty(legacy))}
expect("portable workload translates to the stable Docker contract", legacy["ok"]&&legacy["definition"]["runtime"]["engine_runtime"] == "runsc"&&legacy["definition"]["command"][0] == "sh")
local_inspection := inspect_portable_oci(resolved["definition"], "docker", local_profile)
expect("portable Docker capability resolution preserves semantic controls", local_inspection["ok"]&&len(local_inspection["controls"]) == len(requirements["requirements"]))
remote_fields := parse_json(to_json(local_profile))
remote_fields["credential_ref"] := "env:DOCKER_TOKEN"
expect("built-in OCI profiles reject remote credential routing", portable_to_legacy(resolved["definition"], "docker", remote_fields)["ok"] == false)
allowlisted := parse_json(to_json(resolved["definition"]))
allowlisted_sections := allowlisted["requirements"]
allowlisted_sections["network"] := {"mode": "allowlist", "allow": ["api.example.invalid"]}
allowlisted["requirements"] := allowlisted_sections
allowlisted_requirements := requirements_from_definition(allowlisted)
expect("domain allowlist uses a distinct semantic capability", allowlisted_requirements["ok"]&&has_requirement(allowlisted_requirements["requirements"], "network.allowlist.domain"))
expect("Docker never downgrades a domain allowlist to a custom network", inspect_portable_oci(allowlisted, "docker", local_profile)["ok"] == false)

unbounded_artifacts := parse_json(to_json(definition))
unbounded_artifacts["artifacts"] := {"export": ["result.txt"]}
expect("portable artifact exports require explicit bounds", validate_portable_definition(unbounded_artifacts)["ok"] == false)
oversized_compute := parse_json(to_json(definition))
oversized_requirements := oversized_compute["requirements"]
oversized_values := oversized_requirements["compute"]
oversized_values["memory"] := "65g"
oversized_requirements["compute"] := oversized_values
oversized_compute["requirements"] := oversized_requirements
expect("portable compute bounds reject excessive memory", validate_portable_definition(oversized_compute)["ok"] == false)

caller := {"schema": caller_context_schema_version(), "caller": "dispatch", "workflow_id": "wf-1", "step_id": "step-2", "attempt_id": "attempt-3", "correlation_id": "corr-1", "causation_id": "parent-1"}
expect("bounded caller correlation context validates", validate_caller_context(caller)["ok"])
unsafe_caller := parse_json(to_json(caller))
unsafe_caller["credential"] := "must-not-be-accepted"
expect("caller context rejects provider data and secret-shaped extensions", validate_caller_context(unsafe_caller)["ok"] == false)
oversized_caller := parse_json(to_json(caller))
oversized_caller["correlation_id"] := "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
expect("caller context rejects oversized identifiers", validate_caller_context(oversized_caller)["ok"] == false)

bad := definition
bad["e2b"] := {}
expect("provider blocks are rejected", validate_portable_definition(bad)["ok"] == false)

profile_path := "/tmp/workcell-portable-profile-" + replace(uuid_v4(), "-", "") + ".json"
profiles := {"schema": host_profiles_schema_version(), "profiles": {"fixture": {"backend": "external-fixture", "credential_ref": "", "adapter_options": {"external-fixture": {"mode": "success"}}, "policy": {}}}}
write_file_atomic(profile_path, to_json(profiles), true)
profile := load_host_profile(profile_path, "fixture", "")
expect("explicit host profile loads", profile["ok"]&&profile["backend"] == "external-fixture"&&len(profile["fingerprint"]) == 64)
expect("profile budgets accept bounded workload", validate_profile_budgets(resolved["definition"], {"policy": {"max_cpus": 1, "max_memory_mb": 512, "max_pids": 64, "max_timeout_ms": 10000, "max_output_bytes": 65536, "max_workspace_upload_bytes": 1000000000, "max_artifact_download_bytes": 1048576}})["ok"])
expect("profile budgets reject excessive workload before resolve", validate_profile_budgets(resolved["definition"], {"policy": {"max_timeout_ms": 1000}})["ok"] == false)
expect("backend override conflict fails", load_host_profile(profile_path, "fixture", "e2b")["ok"] == false)
run_argv(["rm", "-f", profile_path], 5000)

unsafe_profile_path := "/tmp/workcell-portable-profile-unsafe-" + replace(uuid_v4(), "-", "") + ".json"
unsafe_profiles := {"schema": host_profiles_schema_version(), "profiles": {"fixture": {"backend": "external-fixture", "endpoint": "http://metadata.internal/", "adapter_options": {}, "policy": {}}}}
write_file_atomic(unsafe_profile_path, to_json(unsafe_profiles), true)
expect("remote profile rejects insecure arbitrary endpoint", load_host_profile(unsafe_profile_path, "fixture", "")["ok"] == false)
unsafe_profile := unsafe_profiles["profiles"]["fixture"]
unsafe_profile["endpoint"] := "http://127.0.0.1:8080"
unsafe_profile["policy"] := {"allow_insecure_loopback_endpoint": true}
unsafe_profile_map := unsafe_profiles["profiles"]
unsafe_profile_map["fixture"] := unsafe_profile
unsafe_profiles["profiles"] := unsafe_profile_map
write_file_atomic(unsafe_profile_path, to_json(unsafe_profiles), true)
expect("profile permits explicit insecure loopback development endpoint", load_host_profile(unsafe_profile_path, "fixture", "")["ok"])
unsafe_profile["endpoint"] := "https://api.example.invalid"
unsafe_profile["policy"] := {"unexpected": true}
unsafe_profile_map["fixture"] := unsafe_profile
unsafe_profiles["profiles"] := unsafe_profile_map
write_file_atomic(unsafe_profile_path, to_json(unsafe_profiles), true)
expect("profile rejects unknown operator policy fields", load_host_profile(unsafe_profile_path, "fixture", "")["ok"] == false)
run_argv(["rm", "-f", unsafe_profile_path], 5000)

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {exit(1)}
