from src.runtime.docker import remove_container, stop_container

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
    failed = failed + 1
    print("FAIL " + label)
}
}

removed := remove_container("missing-container", "docker")
expect("missing container removal is idempotent", removed["ok"]&&contains(to_lower(removed["message"]), "no such container") == 1)
stopped := stop_container("missing-container", "docker")
expect("missing container stop is idempotent", stopped["ok"])

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {
    exit(1)
}
exit(0)
