# Offline Workcell contract tests. These tests do not require Docker.

from src.artifacts.exporter import export_declared, write_execution_logs
from src.domain.definition import default_definition, definition_summary, resolve_definition, validate_definition
from src.policy.policy import build_policy
from src.util import ensure_dir, normalized_relative, process_error, read_text, redact, run_argv, run_id, write_text

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
        failed = failed + 1
        print("FAIL " + label)
    }
}

func with_network(definition, mode) {
    network := definition["network"]
    network["mode"] := mode
    definition["network"] := network
    return definition
}

func with_artifact(definition, path) {
    artifacts := definition["artifacts"]
    artifacts["export"] := [path]
    definition["artifacts"] := artifacts
    return definition
}

func with_image(definition, image) {
    runtime := definition["runtime"]
    runtime["image"] := image
    definition["runtime"] := runtime
    return definition
}

func with_image_digest(definition, digest) {
    runtime := definition["runtime"]
    runtime["image_digest"] := digest
    definition["runtime"] := runtime
    return definition
}

func with_unknown_field(definition) {
    definition["unknown"] := true
    return definition
}

func with_timeout(definition, timeout_value) {
    resources := definition["resources"]
    resources["timeout_ms"] := timeout_value
    definition["resources"] := resources
    return definition
}

func with_secret(definition, secret_name) {
    definition["secrets"] := [secret_name]
    return definition
}

func with_resource(definition, key, value) {
    resources := definition["resources"]
    resources[key] := value
    definition["resources"] := resources
    return definition
}

func with_environment_set(definition, key, value) {
    environment := definition["environment"]
    configured := environment["set"]
    configured[key] := value
    environment["set"] := configured
    definition["environment"] := environment
    return definition
}

func with_environment_allow(definition, key) {
    environment := definition["environment"]
    environment["allow"] := [key]
    definition["environment"] := environment
    return definition
}

func with_build_context(definition, context) {
    runtime := definition["runtime"]
    runtime["build_context"] := context
    definition["runtime"] := runtime
    return definition
}

func with_tmpfs(definition, path) {
    filesystem := definition["filesystem"]
    filesystem["tmpfs"] := [path]
    definition["filesystem"] := filesystem
    return definition
}

func with_mount_path(definition, path) {
    workspace := definition["workspace"]
    workspace["mount_path"] := path
    definition["workspace"] := workspace
    return definition
}

definition := default_definition()
valid := validate_definition(definition)
expect("default definition validates", valid["ok"])
partial := resolve_definition({"network": {}})
expect("partial sections receive nested defaults", partial["ok"] && validate_definition(partial["definition"])["ok"] && definition_summary(partial["definition"])["network_mode"] == "none")
expect("host networking rejected", validate_definition(with_network(definition, "host"))["ok"] == false)
expect("artifact traversal rejected", validate_definition(with_artifact(definition, "../escape"))["ok"] == false)
expect("absolute artifact rejected", validate_definition(with_artifact(definition, "/tmp/escape"))["ok"] == false)
expect("image shell metacharacter rejected", validate_definition(with_image(definition, "alpine;touch"))["ok"] == false)
expect("valid image digest accepted", validate_definition(with_image_digest(definition, "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"))["ok"])
expect("invalid image digest rejected", validate_definition(with_image_digest(definition, "sha256:not-a-digest"))["ok"] == false)
expect("unknown fields rejected", validate_definition(with_unknown_field(definition))["ok"] == false)
expect("invalid timeout rejected", validate_definition(with_timeout(definition, "10x"))["ok"] == false)
expect("fractional timeout rejected", validate_definition(with_timeout(definition, "1.5m"))["ok"] == false)
expect("repository build context is allowed", validate_definition(with_build_context(definition, "."))["ok"])
expect("tmpfs outside /tmp rejected", validate_definition(with_tmpfs(definition, "/etc"))["ok"] == false)
expect("workspace mount outside /workspace rejected", validate_definition(with_mount_path(definition, "/etc"))["ok"] == false)
expect("secret assignment rejected", validate_definition(with_secret(definition, "TOKEN=leak"))["ok"] == false)
expect("CPU limit is bounded", validate_definition(with_resource(definition, "cpus", 65))["ok"] == false)
expect("memory limit is bounded", validate_definition(with_resource(definition, "memory", "128g"))["ok"] == false)
expect("PID limit is bounded", validate_definition(with_resource(definition, "pids", 70000))["ok"] == false)
expect("environment names are validated", validate_definition(with_environment_set(definition, "BAD-NAME", "x"))["ok"] == false)
expect("environment values are strings", validate_definition(with_environment_set(definition, "GOOD_NAME", 7))["ok"] == false)
expect("host-control environment allow rejected", validate_definition(with_environment_allow(definition, "DOCKER_HOST"))["ok"] == false)
expect("proxy environment allow rejected", validate_definition(with_environment_allow(definition, "HTTP_PROXY"))["ok"] == false)
env_policy := build_policy(with_environment_set(definition, "WORKCELL_MODE", "check"), "test-env", "/tmp/workcell-test-workspace")
expect("container environment is explicit", contains(to_string(env_policy["docker_args"]), "WORKCELL_MODE=check") == 1)
secret_policy := build_policy(with_secret(definition, "WORKCELL_TOKEN"), "test-secret", "/tmp/workcell-test-workspace")
expect("secret is passed by name only", contains(to_string(secret_policy["docker_args"]), "WORKCELL_TOKEN") == 1 && contains(to_string(secret_policy["docker_args"]), "secret-value") == 0)

policy := build_policy(definition, "test-run", "/tmp/workcell-test-workspace")
args := policy["docker_args"]
expect("policy includes network mode", contains(to_string(args), "none") == 1)
expect("policy includes read-only root", contains(to_string(args), "--read-only") == 1)
expect("policy drops capabilities", contains(to_string(args), "ALL") == 1)
expect("policy never enables privileged", contains(to_string(args), "--privileged") == 0)
expect("policy never mounts Docker socket", contains(to_string(args), "docker.sock") == 0)
expect("policy labels ownership", contains(to_string(args), "dev.kujo.workcell=true") == 1)
expect("policy enables init and private namespaces", contains(to_string(args), "--init") == 1 && contains(to_string(args), "private") == 1)

expect("relative path normalizes", normalized_relative("build/output.txt")["ok"])
expect("parent traversal rejected", normalized_relative("build/../output.txt")["ok"] == false)
expect("absolute path rejected", normalized_relative("/tmp/output.txt")["ok"] == false)
expect("secret redaction replaces values", redact("token=abc", ["abc"]) == "token=[REDACTED]")
expect("null process output is normalized", process_error({"exitcode": 125, "stderr": null, "timed_out": false}, "docker") == "docker exited with code 125: ")

secret_log_dir := "/tmp/workcell-empty-secret-" + run_id()
ensure_dir(secret_log_dir)
secret_logs := write_execution_logs(secret_log_dir, "hello", "stderr", ["EMPTY_SECRET"])
secret_stdout := read_text(secret_log_dir + "/stdout.log")
secret_stderr := read_text(secret_log_dir + "/stderr.log")
expect("empty secret does not corrupt logs", secret_logs["ok"] && secret_stdout["text"] == "hello" && secret_stderr["text"] == "stderr")
run_argv(["rm", "-rf", secret_log_dir], 30000)

fixture := "/tmp/workcell-contract-fixture.txt"
write_text(fixture, "fixture")
expect("fixture write is readable by exporter", file_exists(fixture))
delete_file(fixture)

export_fixture := "/tmp/workcell-export-fixture-" + run_id()
ensure_dir(export_fixture + "/workspace")
write_text(export_fixture + "/outside.txt", "outside\n")
run_argv(["ln", "-s", export_fixture + "/outside.txt", export_fixture + "/workspace/escape.txt"], 30000)
symlink_export := export_declared(export_fixture + "/workspace", export_fixture + "/output", ["escape.txt"])
expect("symlink artifact source rejected", symlink_export["ok"] == false)
run_argv(["rm", "-rf", export_fixture], 30000)

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {
    exit(1)
}
exit(0)
