# Offline Workcell contract tests. These tests do not require Docker.

from src.artifacts.exporter import export_declared, export_declared_with_policy, write_execution_logs
from src.domain.definition import default_definition, definition_summary, resolve_definition, validate_definition
from src.policy.policy import build_policy
from src.receipts.receipt import add_error, new_receipt
from src.util import ensure_dir, normalized_relative, process_error, read_text, redact, run_argv, run_id, write_text
from src.verification.verification import run_verification_checks

mut passed := 0
mut failed := 0

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
        failed = failed + 1
        print("FAIL " + label)
    }
}

func with_network(definition, mode) {
    network := definition["network"]
    network["mode"] := mode
    definition["network"] := network
    return definition
}

func with_custom_network(definition, name) {
    network := definition["network"]
    network["mode"] := "custom"
    network["name"] := name
    definition["network"] := network
    return definition
}

func with_artifact(definition, path) {
    artifacts := definition["artifacts"]
    artifacts["export"] := [path]
    definition["artifacts"] := artifacts
    return definition
}

func with_image(definition, image) {
    runtime := definition["runtime"]
    runtime["image"] := image
    definition["runtime"] := runtime
    return definition
}

func with_image_digest(definition, digest) {
    runtime := definition["runtime"]
    runtime["image_digest"] := digest
    definition["runtime"] := runtime
    return definition
}

func with_signature_key(definition, key_path) {
    runtime := definition["runtime"]
    runtime["signature_key"] := key_path
    definition["runtime"] := runtime
    return definition
}

func with_unknown_field(definition) {
    definition["unknown"] := true
    return definition
}

func with_timeout(definition, timeout_value) {
    resources := definition["resources"]
    resources["timeout_ms"] := timeout_value
    definition["resources"] := resources
    return definition
}

func with_secret(definition, secret_name) {
    definition["secrets"] := [secret_name]
    return definition
}

func with_duplicate_secret(definition) {
    definition["secrets"] := ["WORKCELL_TOKEN", "WORKCELL_TOKEN"]
    return definition
}

func with_duplicate_artifact(definition) {
    artifacts := definition["artifacts"]
    artifacts["export"] := ["build/output.txt", "build/output.txt"]
    definition["artifacts"] := artifacts
    return definition
}

func with_artifact_policy(definition, key, value) {
    artifacts := definition["artifacts"]
    artifacts[key] := value
    definition["artifacts"] := artifacts
    return definition
}

func with_verification(definition, commands) {
    verification := definition["verification"]
    verification["commands"] := commands
    definition["verification"] := verification
    return definition
}

func with_workspace_scan(definition, key, value) {
    workspace := definition["workspace"]
    scan := workspace["scan"]
    scan[key] := value
    workspace["scan"] := scan
    definition["workspace"] := workspace
    return definition
}

func with_run_as(definition, value) {
    workspace := definition["workspace"]
    workspace["run_as"] := value
    definition["workspace"] := workspace
    return definition
}

func with_resource(definition, key, value) {
    resources := definition["resources"]
    resources[key] := value
    definition["resources"] := resources
    return definition
}

func with_environment_set(definition, key, value) {
    environment := definition["environment"]
    configured := environment["set"]
    configured[key] := value
    environment["set"] := configured
    definition["environment"] := environment
    return definition
}

func with_environment_allow(definition, key) {
    environment := definition["environment"]
    environment["allow"] := [key]
    definition["environment"] := environment
    return definition
}

func with_build_context(definition, context) {
    runtime := definition["runtime"]
    runtime["build_context"] := context
    definition["runtime"] := runtime
    return definition
}

func with_tmpfs(definition, path) {
    filesystem := definition["filesystem"]
    filesystem["tmpfs"] := [path]
    definition["filesystem"] := filesystem
    return definition
}

func with_security_profiles(definition, seccomp, apparmor) {
    filesystem := definition["filesystem"]
    filesystem["seccomp_profile"] := seccomp
    filesystem["apparmor_profile"] := apparmor
    definition["filesystem"] := filesystem
    return definition
}

func with_mount_path(definition, path) {
    workspace := definition["workspace"]
    workspace["mount_path"] := path
    definition["workspace"] := workspace
    return definition
}

definition := default_definition()
valid := validate_definition(definition)
expect("default definition validates", valid["ok"])
partial := resolve_definition({"network": {}})
expect("partial sections receive nested defaults", partial["ok"] && validate_definition(partial["definition"])["ok"] && definition_summary(partial["definition"])["network_mode"] == "none")
expect("host networking rejected", validate_definition(with_network(definition, "host"))["ok"] == false)
expect("custom internal network accepted", validate_definition(with_custom_network(definition, "workcell-internal"))["ok"])
expect("custom network requires a name", validate_definition(with_custom_network(definition, ""))["ok"] == false)
expect("artifact traversal rejected", validate_definition(with_artifact(definition, "../escape"))["ok"] == false)
expect("absolute artifact rejected", validate_definition(with_artifact(definition, "/tmp/escape"))["ok"] == false)
expect("image shell metacharacter rejected", validate_definition(with_image(definition, "alpine;touch"))["ok"] == false)
expect("valid image digest accepted", validate_definition(with_image_digest(definition, "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"))["ok"])
expect("invalid image digest rejected", validate_definition(with_image_digest(definition, "sha256:not-a-digest"))["ok"] == false)
expect("relative signature key accepted", validate_definition(with_signature_key(definition, "keys/workcell.pub"))["ok"])
expect("absolute signature key rejected", validate_definition(with_signature_key(definition, "/tmp/workcell.pub"))["ok"] == false)
expect("unknown fields rejected", validate_definition(with_unknown_field(definition))["ok"] == false)
expect("invalid timeout rejected", validate_definition(with_timeout(definition, "10x"))["ok"] == false)
expect("fractional timeout rejected", validate_definition(with_timeout(definition, "1.5m"))["ok"] == false)
expect("repository build context is allowed", validate_definition(with_build_context(definition, "."))["ok"])
expect("tmpfs outside /tmp rejected", validate_definition(with_tmpfs(definition, "/etc"))["ok"] == false)
expect("custom security profiles accepted", validate_definition(with_security_profiles(definition, "workcell-seccomp", "workcell-apparmor"))["ok"])
expect("unconfined security profile rejected", validate_definition(with_security_profiles(definition, "unconfined", ""))["ok"] == false)
expect("workspace mount outside /workspace rejected", validate_definition(with_mount_path(definition, "/etc"))["ok"] == false)
expect("secret assignment rejected", validate_definition(with_secret(definition, "TOKEN=leak"))["ok"] == false)
expect("duplicate secret rejected", validate_definition(with_duplicate_secret(definition))["ok"] == false)
expect("duplicate artifact rejected", validate_definition(with_duplicate_artifact(definition))["ok"] == false)
expect("artifact max bytes is bounded", validate_definition(with_artifact_policy(definition, "max_bytes", 1000000001))["ok"] == false)
expect("artifact extension policy is validated", validate_definition(with_artifact_policy(definition, "allowed_extensions", ["txt"]))["ok"] == false)
expect("artifact secret action is validated", validate_definition(with_artifact_policy(definition, "secret_action", "leak"))["ok"] == false)
expect("verification command is accepted", validate_definition(with_verification(definition, [{"name": "smoke", "command": ["sh", "-lc", "true"]}]))["ok"])
expect("verification command must be non-empty", validate_definition(with_verification(definition, [{"name": "empty", "command": []}]))["ok"] == false)
expect("workspace scan file limit is bounded", validate_definition(with_workspace_scan(definition, "max_files", 0))["ok"] == false)
expect("workspace scan depth limit is bounded", validate_definition(with_workspace_scan(definition, "max_depth", 257))["ok"] == false)
expect("fixed non-root workspace identity is accepted", validate_definition(with_run_as(definition, "65532:65532"))["ok"])
expect("root workspace identity is rejected", validate_definition(with_run_as(definition, "0:0"))["ok"] == false)
expect("CPU limit is bounded", validate_definition(with_resource(definition, "cpus", 65))["ok"] == false)
expect("memory limit is bounded", validate_definition(with_resource(definition, "memory", "128g"))["ok"] == false)
expect("PID limit is bounded", validate_definition(with_resource(definition, "pids", 70000))["ok"] == false)
expect("environment names are validated", validate_definition(with_environment_set(definition, "BAD-NAME", "x"))["ok"] == false)
expect("environment values are strings", validate_definition(with_environment_set(definition, "GOOD_NAME", 7))["ok"] == false)
expect("host-control environment allow rejected", validate_definition(with_environment_allow(definition, "DOCKER_HOST"))["ok"] == false)
expect("proxy environment allow rejected", validate_definition(with_environment_allow(definition, "HTTP_PROXY"))["ok"] == false)
env_policy := build_policy(with_environment_set(definition, "WORKCELL_MODE", "check"), "test-env", "/tmp/workcell-test-workspace")
expect("container environment is explicit", contains(to_string(env_policy["docker_args"]), "WORKCELL_MODE=check") == 1)
secret_policy := build_policy(with_secret(definition, "WORKCELL_TOKEN"), "test-secret", "/tmp/workcell-test-workspace")
expect("secret is passed by name only", contains(to_string(secret_policy["docker_args"]), "WORKCELL_TOKEN") == 1 && contains(to_string(secret_policy["docker_args"]), "secret-value") == 0)

policy := build_policy(definition, "test-run", "/tmp/workcell-test-workspace")
args := policy["docker_args"]
expect("policy includes network mode", contains(to_string(args), "none") == 1)
custom_policy := build_policy(with_custom_network(definition, "workcell-internal"), "test-custom-network", "/tmp/workcell-test-workspace")
expect("policy attaches custom network by name", contains(to_string(custom_policy["docker_args"]), "workcell-internal") == 1 && custom_policy["network_mode"] == "workcell-internal")
expect("policy includes read-only root", contains(to_string(args), "--read-only") == 1)
expect("policy drops capabilities", contains(to_string(args), "ALL") == 1)
expect("policy never enables privileged", contains(to_string(args), "--privileged") == 0)
expect("policy never mounts Docker socket", contains(to_string(args), "docker.sock") == 0)
expect("policy labels ownership", contains(to_string(args), "dev.kujo.workcell=true") == 1)
expect("policy enables init and private namespaces", contains(to_string(args), "--init") == 1 && contains(to_string(args), "private") == 1)
profile_policy := build_policy(with_security_profiles(definition, "workcell-seccomp", "workcell-apparmor"), "test-security-profiles", "/tmp/workcell-test-workspace")
expect("policy attaches selected security profiles", contains(to_string(profile_policy["docker_args"]), "seccomp=workcell-seccomp") == 1 && contains(to_string(profile_policy["docker_args"]), "apparmor=workcell-apparmor") == 1)
empty_verification := run_verification_checks(definition, {"workspace_path": "/tmp/workcell-test-workspace"}, "wc-0123456789abcdef0123456789abcdef", [], true)
expect("empty verification plan succeeds without Docker work", empty_verification["ok"] && len(empty_verification["checks"]) == 0)
verification_secret_definition := with_verification(with_secret(definition, "AUDIT_SECRET"), [{"name": "secret-check", "command": ["sh", "-lc", "printf artifact-secret"]}])
verification_secret := run_verification_checks(verification_secret_definition, {"workspace_path": "/tmp/workcell-test-workspace"}, "wc-0123456789abcdef0123456789abcdef", ["AUDIT_SECRET"], false)
expect("skipped verification receipt redacts command literals", contains(to_string(verification_secret["checks"]), "artifact-secret") == 0)

expect("relative path normalizes", normalized_relative("build/output.txt")["ok"])
expect("parent traversal rejected", normalized_relative("build/../output.txt")["ok"] == false)
expect("absolute path rejected", normalized_relative("/tmp/output.txt")["ok"] == false)
expect("secret redaction replaces values", redact("token=abc", ["abc"]) == "token=[REDACTED]")
expect("base64-derived secret redaction replaces values", redact("token=" + encode_base64("longsecret"), ["longsecret"]) == "token=[REDACTED]")
expect("null process output is normalized", process_error({"exitcode": 125, "stderr": null, "timed_out": false}, "docker") == "docker exited with code 125: ")

receipt_definition := with_secret(definition, "LONG_SECRET")
receipt_definition["command"] := ["sh", "-lc", "printf longsecret"]
receipt_policy := build_policy(receipt_definition, "test-receipt-redaction", "/tmp/workcell-test-workspace")
receipt := new_receipt(receipt_definition, "workcell.json", "test-receipt-redaction", {"source_root": "/tmp/workcell-source", "source_commit": "abc"}, {"strategy": "git-worktree", "workspace_path": "/tmp/workcell-test-workspace"}, receipt_policy, "/tmp/workcell-output")
receipt_with_error := add_error(receipt, "testing", "secret leaked: longsecret")
expect("receipt command redacts secret literals", contains(to_string(receipt["command"]), "longsecret") == 0)
expect("receipt errors redact secret values", contains(to_string(receipt_with_error["errors"]), "longsecret") == 0)

secret_log_dir := "/tmp/workcell-empty-secret-" + run_id()
ensure_dir(secret_log_dir)
secret_logs := write_execution_logs(secret_log_dir, "hello", "stderr", ["EMPTY_SECRET"])
secret_stdout := read_text(secret_log_dir + "/stdout.log")
secret_stderr := read_text(secret_log_dir + "/stderr.log")
expect("empty secret does not corrupt logs", secret_logs["ok"] && secret_stdout["text"] == "hello" && secret_stderr["text"] == "stderr")
run_argv(["rm", "-rf", secret_log_dir], 30000)

derived_log_dir := "/tmp/workcell-derived-secret-" + run_id()
ensure_dir(derived_log_dir)
derived_logs := write_execution_logs(derived_log_dir, encode_base64("longsecret"), "", ["LONG_SECRET"])
derived_stdout := read_text(derived_log_dir + "/stdout.log")
expect("base64-derived secret is redacted from execution logs", derived_logs["ok"] && derived_stdout["text"] == "[REDACTED]")
run_argv(["rm", "-rf", derived_log_dir], 30000)

fixture := "/tmp/workcell-contract-fixture.txt"
write_text(fixture, "fixture")
expect("fixture write is readable by exporter", file_exists(fixture))
delete_file(fixture)

export_fixture := "/tmp/workcell-export-fixture-" + run_id()
ensure_dir(export_fixture + "/workspace")
write_text(export_fixture + "/outside.txt", "outside\n")
run_argv(["ln", "-s", export_fixture + "/outside.txt", export_fixture + "/workspace/escape.txt"], 30000)
symlink_export := export_declared(export_fixture + "/workspace", export_fixture + "/output", ["escape.txt"])
expect("symlink artifact source rejected", symlink_export["ok"] == false)
run_argv(["rm", "-rf", export_fixture], 30000)

policy_fixture := "/tmp/workcell-artifact-policy-" + run_id()
ensure_dir(policy_fixture + "/workspace/nested")
write_text(policy_fixture + "/workspace/nested/result.txt", "artifact-secret\n")
limited_policy := {"export": ["nested"], "limits": {}, "max_bytes": 4, "max_files": 0, "max_depth": 32, "allowed_extensions": [], "secret_action": "allow"}
limited_export := export_declared_with_policy(policy_fixture + "/workspace", policy_fixture + "/limited", limited_policy, [])
expect("artifact byte limit rejects oversized export", limited_export["ok"] == false && contains(limited_export["error"], "max bytes") == 1)
extension_policy := {"export": ["nested"], "limits": {}, "max_bytes": 0, "max_files": 0, "max_depth": 32, "allowed_extensions": [".md"], "secret_action": "allow"}
extension_export := export_declared_with_policy(policy_fixture + "/workspace", policy_fixture + "/extension", extension_policy, [])
expect("artifact extension policy rejects wrong content type", extension_export["ok"] == false && contains(extension_export["error"], "content type") == 1)
reject_policy := {"export": ["nested/result.txt"], "limits": {}, "max_bytes": 0, "max_files": 0, "max_depth": 32, "allowed_extensions": [], "secret_action": "reject"}
reject_export := export_declared_with_policy(policy_fixture + "/workspace", policy_fixture + "/reject", reject_policy, ["AUDIT_SECRET"])
expect("artifact secret reject hook blocks declared secret", reject_export["ok"] == false)
redact_policy := {"export": ["nested/result.txt"], "limits": {}, "max_bytes": 0, "max_files": 0, "max_depth": 32, "allowed_extensions": [], "secret_action": "redact"}
redact_export := export_declared_with_policy(policy_fixture + "/workspace", policy_fixture + "/redact", redact_policy, ["AUDIT_SECRET"])
redacted_artifact := read_text(policy_fixture + "/redact/nested/result.txt")
expect("artifact secret redaction hook changes exported content", redact_export["ok"] && redacted_artifact["text"] == "[REDACTED]\n")
run_argv(["rm", "-rf", policy_fixture], 30000)

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {
    exit(1)
}
exit(0)
