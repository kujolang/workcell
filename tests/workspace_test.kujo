# Workspace contract test: untracked files must appear in generated patches and reports.

from src.util import ensure_dir, load_json, process_ok, read_text, run_argv, run_id
from src.workspace.workspace import change_details, changed_files, changed_files_from_details, cleanup_workspace, clean_stale_workspaces, create_workspace, find_symlink_with_limits, inspect_repository, make_patch, temp_root, workspace_inventory, write_change_report, write_change_report_from_details

mut passed := 0
mut failed := 0

partial_change_details := change_details({})
expect("partial change details workspace is rejected without runtime crash", partial_change_details["ok"] == false)
partial_changed_files := changed_files({})
expect("partial changed files workspace is rejected without runtime crash", partial_changed_files["ok"] == false)
partial_details := changed_files_from_details({})
expect("partial changed details input is rejected without runtime crash", partial_details["ok"] == false)
partial_report := write_change_report_from_details({}, "/tmp/workcell-partial-report.json", 0, {})
expect("partial change report input is rejected without runtime crash", partial_report["ok"] == false)
partial_patch := make_patch({}, "/tmp/workcell-partial.patch")
expect("partial patch workspace is rejected without runtime crash", partial_patch["ok"] == false)
partial_cleanup := cleanup_workspace({}, false)
expect("partial cleanup workspace is rejected without runtime crash", partial_cleanup["ok"] == false)
partial_scan_limits := find_symlink_with_limits("/tmp", {})
expect("partial workspace scan limits are rejected without runtime crash", partial_scan_limits["ok"] == false)
denied_scan_path := temp_root() + "/kujo-workcell-scan-denied-" + run_id()
denied_created := run_argv(["mkdir", "-p", denied_scan_path], 10000)
denied_mode := run_argv(["chmod", "000", denied_scan_path], 10000)
denied_scan := find_symlink_with_limits(denied_scan_path, {"max_files": 10, "max_bytes": 1000, "max_depth": 2})
run_argv(["chmod", "700", denied_scan_path], 10000)
run_argv(["rm", "-rf", denied_scan_path], 10000)
expect("permission-denied workspace scan is handled without runtime crash", process_ok(denied_created)&&process_ok(denied_mode)&&denied_scan["ok"] == false)

func expect(label, condition) {
    if condition {
        passed = passed + 1
        print("PASS " + label)
    } else {
    failed = failed + 1
    print("FAIL " + label)
}
}

repo := "/tmp/workcell-patch-fixture-" + run_id()
ensure_dir(repo)
run_argv(["git", "-C", repo, "init", "-q"], 30000)
run_argv(["git", "-C", repo, "config", "user.email", "workcell@example.invalid"], 30000)
run_argv(["git", "-C", repo, "config", "user.name", "Workcell"], 30000)
write_file_atomic(repo + "/tracked.txt", "tracked\n", true)
run_argv(["git", "-C", repo, "add", "tracked.txt"], 30000)
run_argv(["git", "-C", repo, "commit", "-qm", "initial"], 30000)

source := inspect_repository(repo)
expect("fixture repository detected", source["ok"])
workspace := create_workspace(repo, "git-worktree", run_id())
expect("disposable worktree created", workspace["ok"])
if workspace["ok"] {
    binary_path := workspace["workspace_path"] + "/added.bin"
    run_argv(["dd", "if=/dev/zero", "of=" + binary_path, "bs=1", "count=1"], 30000)
    patch_path := repo + "/changes.patch"
    patch := make_patch(workspace, patch_path)
    expect("patch generated", patch["ok"])
    patch_text := read_text(patch_path)
    expect("untracked file appears in patch", patch_text["ok"]&&contains(patch_text["text"], "added.bin") == 1)
    report_path := repo + "/changes.json"
    report := write_change_report(workspace, report_path, patch["bytes"])
    expect("structured change report generated", report["ok"])
    report_json := load_json(report_path)
    expect("change report summarizes patch", report_json["ok"]&&report_json["value"]["summary"]["total_files"] == 1&&report_json["value"]["summary"]["binary_files"] == 1&&report_json["value"]["files"][0]["binary"] == true&&report_json["value"]["patch_bytes"] > 0)
    cleanup := cleanup_workspace(workspace, false)
    expect("worktree cleanup succeeded", cleanup["ok"])
}
run_argv(["rm", "-rf", repo], 30000)

spoof := temp_root() + "/kujo-workcell-not-a-real-run"
ensure_dir(spoof)
write_file_atomic(spoof + ".owner", "workcell-run-id=not-a-real-run\n", true)
stale := clean_stale_workspaces([])
expect("spoofed workspace marker is not removed", file_exists(spoof)&&contains(to_string(stale["skipped"]), spoof) == 1)
run_argv(["rm", "-rf", spoof, spoof + ".owner"], 30000)

symlink_marker_run := run_id()
symlink_marker_workspace := temp_root() + "/kujo-workcell-" + symlink_marker_run
symlink_marker_target := temp_root() + "/workcell-owner-target-" + symlink_marker_run
ensure_dir(symlink_marker_workspace)
write_file_atomic(symlink_marker_target, "workcell-run-id=" + symlink_marker_run + "\n", true)
run_argv(["ln", "-s", symlink_marker_target, symlink_marker_workspace + ".owner"], 30000)
symlink_marker_cleanup := cleanup_workspace({"workspace_path": symlink_marker_workspace, "source_root": "/tmp", "strategy": "isolated-clone"}, false)
symlink_marker_inventory := workspace_inventory()
symlink_marker_stale := clean_stale_workspaces([])
expect("symlinked ownership marker cannot authorize direct cleanup", symlink_marker_cleanup["ok"] == false&&file_exists(symlink_marker_workspace))
expect("symlinked ownership marker cannot authorize stale cleanup", symlink_marker_stale["ok"] == false&&file_exists(symlink_marker_workspace)&&contains(to_string(symlink_marker_stale["skipped"]), "path/marker is a symlink") == 1)
expect("workspace inventory identifies symlinked ownership markers", symlink_marker_inventory["ok"]&&contains(to_json(symlink_marker_inventory["workspaces"]), "marker-symlink") == 1)
run_argv(["rm", "-rf", symlink_marker_workspace, symlink_marker_workspace + ".owner", symlink_marker_target], 30000)

active_run := run_id()
active_workspace := temp_root() + "/kujo-workcell-" + active_run
ensure_dir(active_workspace)
write_file_atomic(active_workspace + ".owner", "workcell-run-id=" + active_run + "\n", true)
active_cleanup := clean_stale_workspaces([active_run])
expect("active workspace is preserved during cleanup", file_exists(active_workspace)&&contains(to_string(active_cleanup["skipped"]), "active Workcell run") == 1)
run_argv(["rm", "-rf", active_workspace, active_workspace + ".owner"], 30000)

orphan_run := run_id()
orphan_workspace := temp_root() + "/kujo-workcell-" + orphan_run
ensure_dir(orphan_workspace)
orphan_cleanup := clean_stale_workspaces([])
expect("empty orphan workspace is safely recovered", file_exists(orphan_workspace) == false&&contains(to_string(orphan_cleanup["removed"]), "empty orphan recovered") == 1)

denied_orphan := temp_root() + "/kujo-workcell-" + run_id()
ensure_dir(denied_orphan)
run_argv(["chmod", "000", denied_orphan], 10000)
denied_cleanup := clean_stale_workspaces([])
run_argv(["chmod", "700", denied_orphan], 10000)
expect("permission-denied orphan cleanup is handled without runtime crash", denied_cleanup["ok"] == false&&contains(to_string(denied_cleanup["skipped"]), denied_orphan) == 1)
run_argv(["rm", "-rf", denied_orphan], 30000)

missing_scan := find_symlink_with_limits(temp_root() + "/kujo-workcell-missing-" + run_id(), {"max_files": 100, "max_bytes": 1000000, "max_depth": 8})
expect("missing workspace scan fails with a structured result", missing_scan["ok"] == false&&contains(missing_scan["error"], "workspace disappeared during scan") == 1)

print("Passed: " + to_string(passed))
print("Failed: " + to_string(failed))
if failed > 0 {
    exit(1)
}
exit(0)
